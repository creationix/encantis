MarkdownTests {
  Document = Section*

  Section = sectionHeader SectionBody

  sectionHeader = "#" ~"#" sp* headerText newline

  SectionBody = SectionContent* SubSection*

  SectionContent = ~sectionHeader ~subSectionHeader (CodeBlock | TextLine)

  SubSection = subSectionHeader SubSectionBody

  subSectionHeader = "##" ~"#" sp* headerText newline

  SubSectionBody = (~sectionHeader ~subSectionHeader (CodeBlock | TextLine))*

  CodeBlock = codeStart codeContent codeEnd

  codeStart = "```" language context? newline
  codeContent = (~"```" any)*
  codeEnd = "```" (newline | end)

  language = identChar+
  context = sp+ identChar+

  headerText = (~newline any)+

  TextLine = (~newline any)* newline

  identChar = letter | digit | "_" | "-"
  newline = "\r"? "\n"
  sp = " " | "\t"
}
