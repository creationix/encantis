{
  "$schema": "vscode://schemas/color-theme",
  "name": "Encantis Light Sweetie-16",
  "type": "light",
  "colors": {
    "editor.background": "#f4f4f4",
    "editor.foreground": "#1a1c2c",
    "editorCursor.foreground": "#3b5dc9",
    "editor.lineHighlightBackground": "#e8eef2",
    "editor.selectionBackground": "#94b0c2",
    "editorIndentGuide.background1": "#94b0c2",
    "editorIndentGuide.activeBackground1": "#566c86",
    "editorLineNumber.foreground": "#94b0c2",
    "editorLineNumber.activeForeground": "#566c86",
    "editorRuler.foreground": "#94b0c2",
    "editorBracketMatch.background": "#94b0c2",
    "editorBracketMatch.border": "#3b5dc9",
    "activityBar.background": "#f4f4f4",
    "activityBarBadge.background": "#3b5dc9",
    "sideBar.background": "#f4f4f4",
    "sideBarTitle.foreground": "#566c86",
    "statusBar.background": "#f4f4f4",
    "tab.activeBackground": "#f4f4f4",
    "tab.inactiveBackground": "#e8eef2",
    "titleBar.activeBackground": "#f4f4f4",
    "editorBracketHighlight.foreground1": "#b13e53",
    "editorBracketHighlight.foreground2": "#29366f",
    "editorBracketHighlight.foreground3": "#257179",
    "editorBracketHighlight.foreground4": "#5d275d",
    "editorBracketHighlight.foreground5": "#3b5dc9",
    "editorBracketHighlight.foreground6": "#38b764",
    "editorBracketHighlight.unexpectedBracket.foreground": "#b13e53"
  },
  "tokenColors": [
    {
      "name": "Comments - blue-gray",
      "scope": [
        "comment",
        "comment.line",
        "comment.block"
      ],
      "settings": {
        "foreground": "#566c86",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Control keywords - royal blue",
      "scope": [
        "keyword.control",
        "keyword.control.loop",
        "keyword.control.conditional",
        "keyword.control.flow"
      ],
      "settings": {
        "foreground": "#3b5dc9"
      }
    },
    {
      "name": "Storage keywords - crimson",
      "scope": [
        "keyword",
        "storage.type"
      ],
      "settings": {
        "foreground": "#b13e53"
      }
    },
    {
      "name": "Operators - dark purple",
      "scope": [
        "keyword.operator",
        "keyword.operator.arrow",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.arithmetic",
        "keyword.operator.bitwise"
      ],
      "settings": {
        "foreground": "#5d275d"
      }
    },
    {
      "name": "Strings - green",
      "scope": [
        "string",
        "string.quoted",
        "string.quoted.double",
        "string.quoted.single",
        "string.quoted.other"
      ],
      "settings": {
        "foreground": "#257179"
      }
    },
    {
      "name": "Escape sequences - muted teal",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#388a8c",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Numbers - dark amber (simulated)",
      "scope": [
        "constant.numeric",
        "constant.numeric.decimal",
        "constant.numeric.float",
        "constant.numeric.hex",
        "constant.numeric.binary",
        "constant.numeric.octal",
        "constant.numeric.dozenal"
      ],
      "settings": {
        "foreground": "#b13e53"
      }
    },
    {
      "name": "Null - dark purple-rose",
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#8a2858",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Booleans - dark rose",
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#a03050",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Primitive types - dark teal",
      "scope": [
        "entity.name.type",
        "support.type.builtin"
      ],
      "settings": {
        "foreground": "#257179"
      }
    },
    {
      "name": "User types - dark teal",
      "scope": [
        "support.type",
        "entity.name.type.class"
      ],
      "settings": {
        "foreground": "#257179"
      }
    },
    {
      "name": "Nominal types - purple",
      "scope": [
        "support.type.nominal"
      ],
      "settings": {
        "foreground": "#5d275d",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Comptime types - crimson muted",
      "scope": [
        "support.type.comptime"
      ],
      "settings": {
        "foreground": "#b13e53",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Functions - dark green",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#38b764"
      }
    },
    {
      "name": "Variables - dark blue-gray",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#333c57"
      }
    },
    {
      "name": "Parameters - royal blue",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#3b5dc9",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Output parameters - crimson",
      "scope": [
        "variable.parameter.output"
      ],
      "settings": {
        "foreground": "#b13e53",
        "fontStyle": "italic bold"
      }
    },
    {
      "name": "Global variables - purple",
      "scope": [
        "variable.other.global"
      ],
      "settings": {
        "foreground": "#5d275d"
      }
    },
    {
      "name": "Property access - blue-gray",
      "scope": [
        "punctuation.accessor",
        "punctuation.accessor.property",
        "punctuation.accessor.tuple"
      ],
      "settings": {
        "foreground": "#566c86"
      }
    },
    {
      "name": "Brackets - muted gray",
      "scope": [
        "punctuation.bracket",
        "keyword.operator.bracket"
      ],
      "settings": {
        "foreground": "#566c86"
      }
    },
    {
      "name": "Pointer/deref - dark teal",
      "scope": [
        "punctuation.accessor.pointer"
      ],
      "settings": {
        "foreground": "#257179"
      }
    },
    {
      "name": "Type punning - crimson",
      "scope": [
        "punctuation.accessor.typepun"
      ],
      "settings": {
        "foreground": "#b13e53"
      }
    },
    {
      "name": "Attribute names - coral",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#ef7d57"
      }
    },
    {
      "name": "Invalid - crimson",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#b13e53"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "heading.1.markdown",
        "heading.2.markdown",
        "heading.3.markdown",
        "heading.4.markdown",
        "heading.5.markdown",
        "heading.6.markdown",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#3b5dc9",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown heading punctuation",
      "scope": [
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#29366f"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold",
        "markup.bold.markdown"
      ],
      "settings": {
        "foreground": "#b13e53",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic",
        "markup.italic.markdown"
      ],
      "settings": {
        "foreground": "#5d275d",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown bold italic",
      "scope": [
        "markup.bold markup.italic",
        "markup.italic markup.bold"
      ],
      "settings": {
        "foreground": "#b13e53",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "markup.underline.link.markdown",
        "markup.underline.link.image.markdown",
        "string.other.link.title.markdown",
        "string.other.link.description.markdown"
      ],
      "settings": {
        "foreground": "#257179"
      }
    },
    {
      "name": "Markdown link text",
      "scope": [
        "string.other.link.title.markdown"
      ],
      "settings": {
        "foreground": "#3b5dc9"
      }
    },
    {
      "name": "Markdown inline code",
      "scope": [
        "markup.inline.raw",
        "markup.inline.raw.string.markdown",
        "markup.raw.inline.markdown"
      ],
      "settings": {
        "foreground": "#b13e53"
      }
    },
    {
      "name": "Markdown fenced code block",
      "scope": [
        "markup.fenced_code.block.markdown",
        "markup.raw.block.markdown"
      ],
      "settings": {
        "foreground": "#1a1c2c"
      }
    },
    {
      "name": "Markdown code fence language",
      "scope": [
        "fenced_code.block.language.markdown"
      ],
      "settings": {
        "foreground": "#257179"
      }
    },
    {
      "name": "Markdown blockquote",
      "scope": [
        "markup.quote",
        "markup.quote.markdown"
      ],
      "settings": {
        "foreground": "#566c86",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown list punctuation",
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "beginning.punctuation.definition.list.markdown"
      ],
      "settings": {
        "foreground": "#5d275d"
      }
    },
    {
      "name": "Markdown separator",
      "scope": [
        "meta.separator.markdown"
      ],
      "settings": {
        "foreground": "#94b0c2"
      }
    },
    {
      "name": "Markdown strikethrough",
      "scope": [
        "markup.strikethrough",
        "markup.strikethrough.markdown"
      ],
      "settings": {
        "foreground": "#94b0c2",
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "parameter": {
      "foreground": "#3b5dc9",
      "fontStyle": "italic"
    },
    "parameter.output": {
      "foreground": "#b13e53",
      "fontStyle": "italic bold"
    },
    "variable": "#333c57",
    "variable.readonly": {
      "foreground": "#29366f",
      "fontStyle": "bold"
    },
    "variable.static": "#257179",
    "variable.static.readonly": {
      "foreground": "#257179",
      "fontStyle": "bold"
    },
    "function": "#38b764",
    "function.declaration": {
      "foreground": "#38b764",
      "fontStyle": "bold"
    },
    "type": "#257179",
    "type.declaration": {
      "foreground": "#257179",
      "fontStyle": "bold"
    }
  }
}
