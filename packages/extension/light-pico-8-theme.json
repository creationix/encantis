{
  "$schema": "vscode://schemas/color-theme",
  "name": "Encantis Light PICO-8",
  "type": "light",
  "colors": {
    "editor.background": "#fff1e8",
    "editor.foreground": "#000000",
    "editorCursor.foreground": "#1d2b53",
    "editor.lineHighlightBackground": "#ffccaa",
    "editor.selectionBackground": "#c2c3c7",
    "editorIndentGuide.background1": "#c2c3c7",
    "editorIndentGuide.activeBackground1": "#83769c",
    "editorLineNumber.foreground": "#83769c",
    "editorLineNumber.activeForeground": "#5f574f",
    "editorRuler.foreground": "#c2c3c7",
    "editorBracketMatch.background": "#ffccaa",
    "editorBracketMatch.border": "#1d2b53",
    "activityBar.background": "#fff1e8",
    "activityBarBadge.background": "#1d2b53",
    "sideBar.background": "#fff1e8",
    "sideBarTitle.foreground": "#5f574f",
    "statusBar.background": "#fff1e8",
    "tab.activeBackground": "#fff1e8",
    "tab.inactiveBackground": "#ffccaa",
    "titleBar.activeBackground": "#fff1e8",
    "editorBracketHighlight.foreground1": "#ab5236",
    "editorBracketHighlight.foreground2": "#1d2b53",
    "editorBracketHighlight.foreground3": "#008751",
    "editorBracketHighlight.foreground4": "#7e2553",
    "editorBracketHighlight.foreground5": "#5f574f",
    "editorBracketHighlight.foreground6": "#83769c",
    "editorBracketHighlight.unexpectedBracket.foreground": "#ff004d"
  },
  "tokenColors": [
    {
      "name": "Comments - lavender gray",
      "scope": ["comment", "comment.line", "comment.block"],
      "settings": { "foreground": "#83769c", "fontStyle": "italic" }
    },
    {
      "name": "Control keywords - dark blue",
      "scope": ["keyword.control", "keyword.control.loop", "keyword.control.conditional", "keyword.control.flow"],
      "settings": { "foreground": "#1d2b53" }
    },
    {
      "name": "Storage keywords - brown",
      "scope": ["keyword", "storage.type"],
      "settings": { "foreground": "#ab5236" }
    },
    {
      "name": "Operators - dark purple",
      "scope": ["keyword.operator", "keyword.operator.arrow", "keyword.operator.assignment", "keyword.operator.comparison", "keyword.operator.logical", "keyword.operator.arithmetic", "keyword.operator.bitwise"],
      "settings": { "foreground": "#7e2553" }
    },
    {
      "name": "Strings - dark green",
      "scope": ["string", "string.quoted", "string.quoted.double", "string.quoted.single", "string.quoted.other"],
      "settings": { "foreground": "#008751" }
    },
    {
      "name": "Escape sequences - dark blue",
      "scope": ["constant.character.escape"],
      "settings": { "foreground": "#1d2b53", "fontStyle": "bold" }
    },
    {
      "name": "Numbers - brown",
      "scope": ["constant.numeric", "constant.numeric.decimal", "constant.numeric.float", "constant.numeric.hex", "constant.numeric.binary", "constant.numeric.octal", "constant.numeric.dozenal"],
      "settings": { "foreground": "#ab5236" }
    },
    {
      "name": "Booleans - dark purple",
      "scope": ["constant.language", "constant.language.boolean"],
      "settings": { "foreground": "#7e2553", "fontStyle": "italic" }
    },
    {
      "name": "Primitive types - dark blue",
      "scope": ["entity.name.type", "support.type.builtin"],
      "settings": { "foreground": "#1d2b53" }
    },
    {
      "name": "User types - dark blue",
      "scope": ["support.type", "entity.name.type.class"],
      "settings": { "foreground": "#1d2b53" }
    },
    {
      "name": "Nominal types - dark purple",
      "scope": ["support.type.nominal"],
      "settings": { "foreground": "#7e2553", "fontStyle": "italic" }
    },
    {
      "name": "Comptime types - brown",
      "scope": ["support.type.comptime"],
      "settings": { "foreground": "#ab5236", "fontStyle": "italic" }
    },
    {
      "name": "Functions - dark green",
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#008751" }
    },
    {
      "name": "Variables - dark gray",
      "scope": ["variable", "variable.other"],
      "settings": { "foreground": "#5f574f" }
    },
    {
      "name": "Parameters - dark blue",
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#1d2b53", "fontStyle": "italic" }
    },
    {
      "name": "Output parameters - brown",
      "scope": ["variable.parameter.output"],
      "settings": { "foreground": "#ab5236", "fontStyle": "italic bold" }
    },
    {
      "name": "Global variables - dark purple",
      "scope": ["variable.other.global"],
      "settings": { "foreground": "#7e2553" }
    },
    {
      "name": "Property access - gray",
      "scope": ["punctuation.accessor", "punctuation.accessor.property", "punctuation.accessor.tuple"],
      "settings": { "foreground": "#5f574f" }
    },
    {
      "name": "Brackets - lavender",
      "scope": ["punctuation.bracket", "keyword.operator.bracket"],
      "settings": { "foreground": "#83769c" }
    },
    {
      "name": "Pointer/deref - dark blue",
      "scope": ["punctuation.accessor.pointer"],
      "settings": { "foreground": "#1d2b53" }
    },
    {
      "name": "Type punning - brown",
      "scope": ["punctuation.accessor.typepun"],
      "settings": { "foreground": "#ab5236" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "heading.1.markdown", "heading.2.markdown", "heading.3.markdown", "heading.4.markdown", "heading.5.markdown", "heading.6.markdown", "entity.name.section.markdown"],
      "settings": { "foreground": "#1d2b53", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold", "markup.bold.markdown"],
      "settings": { "foreground": "#ab5236", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic", "markup.italic.markdown"],
      "settings": { "foreground": "#7e2553", "fontStyle": "italic" }
    },
    {
      "name": "Markdown links",
      "scope": ["markup.underline.link", "markup.underline.link.markdown"],
      "settings": { "foreground": "#008751" }
    },
    {
      "name": "Markdown inline code",
      "scope": ["markup.inline.raw", "markup.inline.raw.string.markdown", "markup.raw.inline.markdown"],
      "settings": { "foreground": "#ab5236" }
    },
    {
      "name": "Markdown blockquote",
      "scope": ["markup.quote", "markup.quote.markdown"],
      "settings": { "foreground": "#83769c", "fontStyle": "italic" }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "parameter": { "foreground": "#1d2b53", "fontStyle": "italic" },
    "parameter.output": { "foreground": "#ab5236", "fontStyle": "italic bold" },
    "variable": "#5f574f",
    "variable.readonly": { "foreground": "#5f574f", "fontStyle": "bold" },
    "variable.static": "#7e2553",
    "variable.static.readonly": { "foreground": "#7e2553", "fontStyle": "bold" },
    "function": "#008751",
    "function.declaration": { "foreground": "#008751", "fontStyle": "bold" },
    "type": "#1d2b53",
    "type.declaration": { "foreground": "#1d2b53", "fontStyle": "bold" }
  }
}
