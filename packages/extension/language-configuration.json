{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  // A name has hyphens: prime64-1, my-func (double-click and word moves)
  "wordPattern": "[a-zA-Z_][a-zA-Z0-9_-]*",
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  // A backtick starts a template string; single quotes hold codepoints ('a')
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "`", "close": "`", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"],
    ["`", "`"]
  ]
}
