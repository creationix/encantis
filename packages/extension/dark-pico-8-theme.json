{
  "$schema": "vscode://schemas/color-theme",
  "name": "Encantis Dark PICO-8",
  "type": "dark",
  "colors": {
    "editor.background": "#000000",
    "editor.foreground": "#fff1e8",
    "editorCursor.foreground": "#29adff",
    "editor.lineHighlightBackground": "#0d1525",
    "editor.selectionBackground": "#7e2553",
    "editorIndentGuide.background1": "#5f574f",
    "editorIndentGuide.activeBackground1": "#83769c",
    "editorLineNumber.foreground": "#5f574f",
    "editorLineNumber.activeForeground": "#c2c3c7",
    "editorRuler.foreground": "#5f574f",
    "editorBracketMatch.background": "#1d2b53",
    "editorBracketMatch.border": "#29adff",
    "activityBar.background": "#000000",
    "activityBarBadge.background": "#29adff",
    "sideBar.background": "#000000",
    "sideBarTitle.foreground": "#c2c3c7",
    "statusBar.background": "#1d2b53",
    "tab.activeBackground": "#1d2b53",
    "tab.inactiveBackground": "#000000",
    "titleBar.activeBackground": "#000000",
    "editorBracketHighlight.foreground1": "#ffa300",
    "editorBracketHighlight.foreground2": "#29adff",
    "editorBracketHighlight.foreground3": "#00e436",
    "editorBracketHighlight.foreground4": "#ffec27",
    "editorBracketHighlight.foreground5": "#ff77a8",
    "editorBracketHighlight.foreground6": "#83769c",
    "editorBracketHighlight.unexpectedBracket.foreground": "#ff004d"
  },
  "tokenColors": [
    {
      "name": "Comments - lavender gray",
      "scope": ["comment", "comment.line", "comment.block"],
      "settings": { "foreground": "#83769c", "fontStyle": "italic" }
    },
    {
      "name": "Control keywords - blue",
      "scope": ["keyword.control", "keyword.control.loop", "keyword.control.conditional", "keyword.control.flow"],
      "settings": { "foreground": "#29adff" }
    },
    {
      "name": "Storage keywords - orange",
      "scope": ["keyword", "storage.type"],
      "settings": { "foreground": "#ffa300" }
    },
    {
      "name": "Operators - red",
      "scope": ["keyword.operator", "keyword.operator.arrow", "keyword.operator.assignment", "keyword.operator.comparison", "keyword.operator.logical", "keyword.operator.arithmetic", "keyword.operator.bitwise"],
      "settings": { "foreground": "#ff004d" }
    },
    {
      "name": "Strings - green",
      "scope": ["string", "string.quoted", "string.quoted.double", "string.quoted.single", "string.quoted.other"],
      "settings": { "foreground": "#00e436" }
    },
    {
      "name": "Escape sequences - yellow",
      "scope": ["constant.character.escape"],
      "settings": { "foreground": "#ffec27", "fontStyle": "bold" }
    },
    {
      "name": "Numbers - yellow",
      "scope": ["constant.numeric", "constant.numeric.decimal", "constant.numeric.float", "constant.numeric.hex", "constant.numeric.binary", "constant.numeric.octal", "constant.numeric.dozenal"],
      "settings": { "foreground": "#ffec27" }
    },
    {
      "name": "Booleans - pink",
      "scope": ["constant.language", "constant.language.boolean"],
      "settings": { "foreground": "#ff77a8", "fontStyle": "italic" }
    },
    {
      "name": "Primitive types - blue",
      "scope": ["entity.name.type", "support.type.builtin"],
      "settings": { "foreground": "#29adff" }
    },
    {
      "name": "User types - blue",
      "scope": ["support.type", "entity.name.type.class"],
      "settings": { "foreground": "#29adff" }
    },
    {
      "name": "Nominal types - pink",
      "scope": ["support.type.nominal"],
      "settings": { "foreground": "#ff77a8", "fontStyle": "italic" }
    },
    {
      "name": "Comptime types - peach",
      "scope": ["support.type.comptime"],
      "settings": { "foreground": "#ffccaa", "fontStyle": "italic" }
    },
    {
      "name": "Functions - bright green",
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#00e436" }
    },
    {
      "name": "Variables - light gray",
      "scope": ["variable", "variable.other"],
      "settings": { "foreground": "#c2c3c7" }
    },
    {
      "name": "Parameters - blue",
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#29adff", "fontStyle": "italic" }
    },
    {
      "name": "Output parameters - orange",
      "scope": ["variable.parameter.output"],
      "settings": { "foreground": "#ffa300", "fontStyle": "italic bold" }
    },
    {
      "name": "Global variables - pink",
      "scope": ["variable.other.global"],
      "settings": { "foreground": "#ff77a8" }
    },
    {
      "name": "Property access - gray",
      "scope": ["punctuation.accessor", "punctuation.accessor.property", "punctuation.accessor.tuple"],
      "settings": { "foreground": "#c2c3c7" }
    },
    {
      "name": "Brackets - lavender",
      "scope": ["punctuation.bracket", "keyword.operator.bracket"],
      "settings": { "foreground": "#83769c" }
    },
    {
      "name": "Pointer/deref - blue",
      "scope": ["punctuation.accessor.pointer"],
      "settings": { "foreground": "#29adff" }
    },
    {
      "name": "Type punning - orange",
      "scope": ["punctuation.accessor.typepun"],
      "settings": { "foreground": "#ffa300" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "heading.1.markdown", "heading.2.markdown", "heading.3.markdown", "heading.4.markdown", "heading.5.markdown", "heading.6.markdown", "entity.name.section.markdown"],
      "settings": { "foreground": "#29adff", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold", "markup.bold.markdown"],
      "settings": { "foreground": "#ffa300", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic", "markup.italic.markdown"],
      "settings": { "foreground": "#ff77a8", "fontStyle": "italic" }
    },
    {
      "name": "Markdown links",
      "scope": ["markup.underline.link", "markup.underline.link.markdown"],
      "settings": { "foreground": "#00e436" }
    },
    {
      "name": "Markdown inline code",
      "scope": ["markup.inline.raw", "markup.inline.raw.string.markdown", "markup.raw.inline.markdown"],
      "settings": { "foreground": "#ffec27" }
    },
    {
      "name": "Markdown blockquote",
      "scope": ["markup.quote", "markup.quote.markdown"],
      "settings": { "foreground": "#83769c", "fontStyle": "italic" }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "parameter": { "foreground": "#29adff", "fontStyle": "italic" },
    "parameter.output": { "foreground": "#ffa300", "fontStyle": "italic bold" },
    "variable": "#c2c3c7",
    "variable.readonly": { "foreground": "#c2c3c7", "fontStyle": "bold" },
    "variable.static": "#ff77a8",
    "variable.static.readonly": { "foreground": "#ff77a8", "fontStyle": "bold" },
    "function": "#00e436",
    "function.declaration": { "foreground": "#00e436", "fontStyle": "bold" },
    "type": "#29adff",
    "type.declaration": { "foreground": "#29adff", "fontStyle": "bold" }
  }
}
