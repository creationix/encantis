{
  "$schema": "vscode://schemas/color-theme",
  "name": "Encantis Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#0d0d0f",
    "editor.foreground": "#e8e6e3",
    "editorCursor.foreground": "#77bbff",
    "editor.lineHighlightBackground": "#1a1a1f",
    "editor.selectionBackground": "#3d3d4a",
    "editorIndentGuide.background1": "#2a2a30",
    "editorIndentGuide.activeBackground1": "#4a4a55",
    "editorLineNumber.foreground": "#4a4a55",
    "editorLineNumber.activeForeground": "#8a8a95",
    "editorRuler.foreground": "#2a2a30",
    "editorBracketMatch.background": "#3d3d4a",
    "editorBracketMatch.border": "#44aaee",
    "activityBar.background": "#0a0a0c",
    "activityBarBadge.background": "#77bbff",
    "sideBar.background": "#0a0a0c",
    "sideBarTitle.foreground": "#9a98a0",
    "statusBar.background": "#0a0a0c",
    "tab.activeBackground": "#0d0d0f",
    "tab.inactiveBackground": "#0a0a0c",
    "titleBar.activeBackground": "#0a0a0c",
    "editorBracketHighlight.foreground1": "#ff9944",
    "editorBracketHighlight.foreground2": "#44aaee",
    "editorBracketHighlight.foreground3": "#cc88ee",
    "editorBracketHighlight.foreground4": "#55cc99",
    "editorBracketHighlight.foreground5": "#ff6644",
    "editorBracketHighlight.foreground6": "#9988ff",
    "editorBracketHighlight.unexpectedBracket.foreground": "#ff4444"
  },
  "tokenColors": [
    {
      "name": "Comments - muted violet",
      "scope": [
        "comment",
        "comment.line",
        "comment.block"
      ],
      "settings": {
        "foreground": "#8877aa",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Control keywords - sky blue",
      "scope": [
        "keyword.control",
        "keyword.control.loop",
        "keyword.control.conditional",
        "keyword.control.flow"
      ],
      "settings": {
        "foreground": "#77bbff"
      }
    },
    {
      "name": "Storage keywords - yellow-orange",
      "scope": [
        "keyword",
        "storage.type"
      ],
      "settings": {
        "foreground": "#ff9944"
      }
    },
    {
      "name": "Operators - orange",
      "scope": [
        "keyword.operator",
        "keyword.operator.arrow",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.arithmetic",
        "keyword.operator.bitwise"
      ],
      "settings": {
        "foreground": "#ff7755"
      }
    },
    {
      "name": "Strings - seafoam",
      "scope": [
        "string",
        "string.quoted",
        "string.quoted.double",
        "string.quoted.single",
        "string.quoted.other"
      ],
      "settings": {
        "foreground": "#55cc99"
      }
    },
    {
      "name": "Escape sequences - pale seafoam",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#80d8ae",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Numbers - amber",
      "scope": [
        "constant.numeric",
        "constant.numeric.decimal",
        "constant.numeric.float",
        "constant.numeric.hex",
        "constant.numeric.binary",
        "constant.numeric.octal",
        "constant.numeric.dozenal"
      ],
      "settings": {
        "foreground": "#eebb55"
      }
    },
    {
      "name": "Booleans - violet-blue",
      "scope": [
        "constant.language",
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#9988ff",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Primitive types - soft cyan",
      "scope": [
        "entity.name.type",
        "support.type.builtin"
      ],
      "settings": {
        "foreground": "#66ccdd"
      }
    },
    {
      "name": "User types - soft cyan",
      "scope": [
        "support.type",
        "entity.name.type.class"
      ],
      "settings": {
        "foreground": "#66ccdd"
      }
    },
    {
      "name": "Nominal types - orchid",
      "scope": [
        "support.type.nominal"
      ],
      "settings": {
        "foreground": "#cc88ee",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Comptime types - muted amber",
      "scope": [
        "support.type.comptime"
      ],
      "settings": {
        "foreground": "#ddaa55",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Functions - lime",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#a6e22e"
      }
    },
    {
      "name": "Variables - light blue",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#99ccff"
      }
    },
    {
      "name": "Parameters - cyan-blue",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#44aaee",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Output parameters - red-orange",
      "scope": [
        "variable.parameter.output"
      ],
      "settings": {
        "foreground": "#ff6644",
        "fontStyle": "italic bold"
      }
    },
    {
      "name": "Global variables - pink",
      "scope": [
        "variable.other.global"
      ],
      "settings": {
        "foreground": "#ff88aa"
      }
    },
    {
      "name": "Property access - soft gray-blue",
      "scope": [
        "punctuation.accessor",
        "punctuation.accessor.property",
        "punctuation.accessor.tuple"
      ],
      "settings": {
        "foreground": "#99aabb"
      }
    },
    {
      "name": "Brackets - muted gray",
      "scope": [
        "punctuation.bracket",
        "keyword.operator.bracket"
      ],
      "settings": {
        "foreground": "#8899aa"
      }
    },
    {
      "name": "Pointer/deref - bright cyan-blue",
      "scope": [
        "punctuation.accessor.pointer"
      ],
      "settings": {
        "foreground": "#44ccff"
      }
    },
    {
      "name": "Type punning - amber",
      "scope": [
        "punctuation.accessor.typepun"
      ],
      "settings": {
        "foreground": "#eebb55"
      }
    },
    {
      "name": "Attribute names - muted rose",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#cc7799"
      }
    },
    {
      "name": "Invalid - error red",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff4444"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "heading.1.markdown",
        "heading.2.markdown",
        "heading.3.markdown",
        "heading.4.markdown",
        "heading.5.markdown",
        "heading.6.markdown",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#77bbff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown heading punctuation",
      "scope": [
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#5599cc"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold",
        "markup.bold.markdown"
      ],
      "settings": {
        "foreground": "#ff9944",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic",
        "markup.italic.markdown"
      ],
      "settings": {
        "foreground": "#cc88ee",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown bold italic",
      "scope": [
        "markup.bold markup.italic",
        "markup.italic markup.bold"
      ],
      "settings": {
        "foreground": "#ee99cc",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "markup.underline.link.markdown",
        "markup.underline.link.image.markdown",
        "string.other.link.title.markdown",
        "string.other.link.description.markdown"
      ],
      "settings": {
        "foreground": "#55cc99"
      }
    },
    {
      "name": "Markdown link text",
      "scope": [
        "string.other.link.title.markdown"
      ],
      "settings": {
        "foreground": "#44aaee"
      }
    },
    {
      "name": "Markdown inline code",
      "scope": [
        "markup.inline.raw",
        "markup.inline.raw.string.markdown",
        "markup.raw.inline.markdown"
      ],
      "settings": {
        "foreground": "#eebb55"
      }
    },
    {
      "name": "Markdown fenced code block",
      "scope": [
        "markup.fenced_code.block.markdown",
        "markup.raw.block.markdown"
      ],
      "settings": {
        "foreground": "#e8e6e3"
      }
    },
    {
      "name": "Markdown code fence language",
      "scope": [
        "fenced_code.block.language.markdown"
      ],
      "settings": {
        "foreground": "#66ccdd"
      }
    },
    {
      "name": "Markdown blockquote",
      "scope": [
        "markup.quote",
        "markup.quote.markdown"
      ],
      "settings": {
        "foreground": "#8877aa",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown list punctuation",
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "beginning.punctuation.definition.list.markdown"
      ],
      "settings": {
        "foreground": "#ff7755"
      }
    },
    {
      "name": "Markdown separator",
      "scope": [
        "meta.separator.markdown"
      ],
      "settings": {
        "foreground": "#4a4a55"
      }
    },
    {
      "name": "Markdown strikethrough",
      "scope": [
        "markup.strikethrough",
        "markup.strikethrough.markdown"
      ],
      "settings": {
        "foreground": "#6a6a75",
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "parameter": {
      "foreground": "#44aaee",
      "fontStyle": "italic"
    },
    "parameter.output": {
      "foreground": "#ff6644",
      "fontStyle": "italic bold"
    },
    "variable": "#99ccff",
    "variable.readonly": {
      "foreground": "#aaddff",
      "fontStyle": "bold"
    },
    "variable.static": "#77bbff",
    "variable.static.readonly": {
      "foreground": "#aabbee",
      "fontStyle": "bold"
    },
    "function": "#a6e22e",
    "function.declaration": {
      "foreground": "#a6e22e",
      "fontStyle": "bold"
    },
    "type": "#66ccdd",
    "type.declaration": {
      "foreground": "#66ccdd",
      "fontStyle": "bold"
    }
  }
}
