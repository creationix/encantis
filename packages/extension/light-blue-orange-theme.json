{
  "$schema": "vscode://schemas/color-theme",
  "name": "Encantis Light Blue-Orange",
  "type": "light",
  "colors": {
    "editor.background": "#faf8f5",
    "editor.foreground": "#2d2a26",
    "editorCursor.foreground": "#2255aa",
    "editor.lineHighlightBackground": "#f0ede8",
    "editor.selectionBackground": "#d4e5ff",
    "editorIndentGuide.background1": "#e0ddd8",
    "editorIndentGuide.activeBackground1": "#c0bdb8",
    "editorLineNumber.foreground": "#a0a0a0",
    "editorLineNumber.activeForeground": "#606060",
    "editorRuler.foreground": "#e0ddd8",
    "editorBracketMatch.background": "#d4e5ff",
    "editorBracketMatch.border": "#2266aa",
    "activityBar.background": "#f5f3f0",
    "activityBarBadge.background": "#2255aa",
    "sideBar.background": "#f5f3f0",
    "sideBarTitle.foreground": "#606060",
    "statusBar.background": "#f5f3f0",
    "tab.activeBackground": "#faf8f5",
    "tab.inactiveBackground": "#f5f3f0",
    "titleBar.activeBackground": "#f5f3f0",
    "editorBracketHighlight.foreground1": "#cc6622",
    "editorBracketHighlight.foreground2": "#2266aa",
    "editorBracketHighlight.foreground3": "#884488",
    "editorBracketHighlight.foreground4": "#228855",
    "editorBracketHighlight.foreground5": "#cc4422",
    "editorBracketHighlight.foreground6": "#5544aa",
    "editorBracketHighlight.unexpectedBracket.foreground": "#cc2222"
  },
  "tokenColors": [
    {
      "name": "Comments - muted mauve",
      "scope": [
        "comment",
        "comment.line",
        "comment.block"
      ],
      "settings": {
        "foreground": "#887799",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Control keywords - deep blue",
      "scope": [
        "keyword.control",
        "keyword.control.loop",
        "keyword.control.conditional",
        "keyword.control.flow"
      ],
      "settings": {
        "foreground": "#2255aa"
      }
    },
    {
      "name": "Storage keywords - dark yellow-orange",
      "scope": [
        "keyword",
        "storage.type"
      ],
      "settings": {
        "foreground": "#cc6622"
      }
    },
    {
      "name": "Operators - dark orange",
      "scope": [
        "keyword.operator",
        "keyword.operator.arrow",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.arithmetic",
        "keyword.operator.bitwise"
      ],
      "settings": {
        "foreground": "#bb5533"
      }
    },
    {
      "name": "Strings - dark seafoam",
      "scope": [
        "string",
        "string.quoted",
        "string.quoted.double",
        "string.quoted.single",
        "string.quoted.other"
      ],
      "settings": {
        "foreground": "#228855"
      }
    },
    {
      "name": "Escape sequences - muted seafoam",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#3a9a68",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Numbers - dark amber",
      "scope": [
        "constant.numeric",
        "constant.numeric.decimal",
        "constant.numeric.float",
        "constant.numeric.hex",
        "constant.numeric.binary",
        "constant.numeric.octal",
        "constant.numeric.dozenal"
      ],
      "settings": {
        "foreground": "#996622"
      }
    },
    {
      "name": "Booleans - dark violet-blue",
      "scope": [
        "constant.language",
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#5544aa",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Primitive types - dark cyan",
      "scope": [
        "entity.name.type",
        "support.type.builtin"
      ],
      "settings": {
        "foreground": "#227799"
      }
    },
    {
      "name": "User types - dark cyan",
      "scope": [
        "support.type",
        "entity.name.type.class"
      ],
      "settings": {
        "foreground": "#227799"
      }
    },
    {
      "name": "Nominal types - plum",
      "scope": [
        "support.type.nominal"
      ],
      "settings": {
        "foreground": "#884488",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Comptime types - dark amber",
      "scope": [
        "support.type.comptime"
      ],
      "settings": {
        "foreground": "#775522",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Functions - forest",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#338833"
      }
    },
    {
      "name": "Variables - dark steel",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#335588"
      }
    },
    {
      "name": "Parameters - dark cyan-blue",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#2266aa",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Output parameters - dark red-orange",
      "scope": [
        "variable.parameter.output"
      ],
      "settings": {
        "foreground": "#cc4422",
        "fontStyle": "italic bold"
      }
    },
    {
      "name": "Global variables - wine",
      "scope": [
        "variable.other.global"
      ],
      "settings": {
        "foreground": "#aa4466"
      }
    },
    {
      "name": "Property access - slate",
      "scope": [
        "punctuation.accessor",
        "punctuation.accessor.property",
        "punctuation.accessor.tuple"
      ],
      "settings": {
        "foreground": "#556677"
      }
    },
    {
      "name": "Brackets - gray",
      "scope": [
        "punctuation.bracket",
        "keyword.operator.bracket"
      ],
      "settings": {
        "foreground": "#667788"
      }
    },
    {
      "name": "Pointer/deref - dark cyan-blue",
      "scope": [
        "punctuation.accessor.pointer"
      ],
      "settings": {
        "foreground": "#2277aa"
      }
    },
    {
      "name": "Type punning - dark amber",
      "scope": [
        "punctuation.accessor.typepun"
      ],
      "settings": {
        "foreground": "#996622"
      }
    },
    {
      "name": "Attribute names - muted mauve",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#995566"
      }
    },
    {
      "name": "Invalid - error red",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#cc2222"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "heading.1.markdown",
        "heading.2.markdown",
        "heading.3.markdown",
        "heading.4.markdown",
        "heading.5.markdown",
        "heading.6.markdown",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#2255aa",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown heading punctuation",
      "scope": [
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#3366aa"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold",
        "markup.bold.markdown"
      ],
      "settings": {
        "foreground": "#cc6622",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic",
        "markup.italic.markdown"
      ],
      "settings": {
        "foreground": "#884488",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown bold italic",
      "scope": [
        "markup.bold markup.italic",
        "markup.italic markup.bold"
      ],
      "settings": {
        "foreground": "#995577",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "markup.underline.link.markdown",
        "markup.underline.link.image.markdown",
        "string.other.link.title.markdown",
        "string.other.link.description.markdown"
      ],
      "settings": {
        "foreground": "#228855"
      }
    },
    {
      "name": "Markdown link text",
      "scope": [
        "string.other.link.title.markdown"
      ],
      "settings": {
        "foreground": "#2266aa"
      }
    },
    {
      "name": "Markdown inline code",
      "scope": [
        "markup.inline.raw",
        "markup.inline.raw.string.markdown",
        "markup.raw.inline.markdown"
      ],
      "settings": {
        "foreground": "#996622"
      }
    },
    {
      "name": "Markdown fenced code block",
      "scope": [
        "markup.fenced_code.block.markdown",
        "markup.raw.block.markdown"
      ],
      "settings": {
        "foreground": "#2d2a26"
      }
    },
    {
      "name": "Markdown code fence language",
      "scope": [
        "fenced_code.block.language.markdown"
      ],
      "settings": {
        "foreground": "#227799"
      }
    },
    {
      "name": "Markdown blockquote",
      "scope": [
        "markup.quote",
        "markup.quote.markdown"
      ],
      "settings": {
        "foreground": "#887799",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown list punctuation",
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "beginning.punctuation.definition.list.markdown"
      ],
      "settings": {
        "foreground": "#bb5533"
      }
    },
    {
      "name": "Markdown separator",
      "scope": [
        "meta.separator.markdown"
      ],
      "settings": {
        "foreground": "#c0bdb8"
      }
    },
    {
      "name": "Markdown strikethrough",
      "scope": [
        "markup.strikethrough",
        "markup.strikethrough.markdown"
      ],
      "settings": {
        "foreground": "#909090",
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "parameter": {
      "foreground": "#2266aa",
      "fontStyle": "italic"
    },
    "parameter.output": {
      "foreground": "#cc4422",
      "fontStyle": "italic bold"
    },
    "variable": "#335588",
    "variable.readonly": {
      "foreground": "#224477",
      "fontStyle": "bold"
    },
    "variable.static": "#2255aa",
    "variable.static.readonly": {
      "foreground": "#334499",
      "fontStyle": "bold"
    },
    "function": "#338833",
    "function.declaration": {
      "foreground": "#338833",
      "fontStyle": "bold"
    },
    "type": "#227799",
    "type.declaration": {
      "foreground": "#227799",
      "fontStyle": "bold"
    }
  }
}
