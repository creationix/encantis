func set_100(b: *mut [4]u32, i: u32#100) {
  b[i >> 5] |= 1 << (i & 31)
}
func has_100(b: *[4]u32, i: u32#100) -> bool => ((b[i >> 5] >> (i & 31)) & 1) == 1

data seen = mut [0:u32; 4]

export func mark(k: u32) { set_100(seen, k % 100) }
export func marked(k: u32) -> bool => has_100(seen, k % 100)

test "bits" {
  mark(99)
  mark(3)
  assert marked(99)
  assert marked(103)
  assert !marked(4)
}
