// A small bump stack (the same interface as a board-builder port's
// stack/stack.ents). What is allocated is checked against the room left,
// capacity - top, which does not wrap, since top is never past capacity;
// top + n could (as lib/stack.ents does).
def capacity = 65536:u32
data space = mut [0:u8; 65536]
global top: u32 = 0

export func mark() -> u32 => (space as u32) + top

export func reset(m: u32) {
  let at = m - (space as u32)
  assert at <= capacity
  top = at
}

export func alloc(n: u32) -> (p: u32) {
  top = (top + 7) & 0xFFFFFFF8
  assert n <= capacity - top
  p = (space as u32) + top
  top += n
}

export func extend(n: u32) -> (p: u32) {
  assert n <= capacity - top
  p = (space as u32) + top
  top += n
}
