{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": ".",
    "noEmit": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler"
  },
  "include": ["*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "**/*.test.ts", "tests/**/*", "dist/**/*", "encantis-grammar.bundle.ts"]
}
