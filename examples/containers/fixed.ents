// The fixed-capacity containers of lib/ next to the growing Vec: a
// FixedVec, a Ring and a bitset, whose capacities are in their types. Each
// index into them is proven by its capacity and compiles to a plain load or
// store.
//
// lib/vec and lib/fixedvec both export push, and a module's generics have
// names of their own: FixedVec's push is imported as fixed_push, and called
// so, as a method too.

import "../../lib/stack" (
  "mark" func mark() -> u32
  "reset" func reset(m: u32)
)
import "../../lib/fixedalloc" "fixedvec" func fixedvec(comptime n: u32, comptime T: type) -> *mut FixedVec(n, T)

import "../../lib/vec" (
  "Vec" func Vec(comptime T: type) -> type
  "vec" func vec(comptime T: type, cap: u32) -> *mut Vec(T)
  "push" func push(comptime T: type, v: *mut Vec(T), x: T)
)

import "../../lib/fixedvec" (
  "FixedVec" func FixedVec(comptime n: u32, comptime T: type) -> type
  "push" func fixed_push(comptime n: u32, comptime T: type, v: *mut FixedVec(n, T), x: T) -> bool
)

import "../../lib/ring" (
  "Ring" func Ring(comptime n: u32#2147483649, comptime T: type) -> type
  "push" func record(comptime n: u32, comptime T: type, r: *mut Ring(n, T), x: T)
  "oldest" func oldest(comptime n: u32, comptime T: type, r: *Ring(n, T), i: u32#n) -> T
)

import "../../lib/bits" (
  "set_bit" func set_bit(comptime w: u32, b: *mut [w]u32, i: u32#(w * 32))
  "count_bits" func count_bits(comptime w: u32, b: *[w]u32) -> u32
)

type Cell = (x: i32, y: i32)

// The board is side by side cells.
def side = 16

// The neighbours of a cell on the board: at most four, so a FixedVec(4, Cell)
// holds them with no growing.
export func neighbours(c: Cell) -> u32 {
  let scope = mark()
  defer reset(scope)
  let out = fixedvec(4, Cell)
  if c.x > 0 { out.fixed_push(Cell(c.x - 1, c.y)) }
  if c.x < side - 1 { out.fixed_push(Cell(c.x + 1, c.y)) }
  if c.y > 0 { out.fixed_push(Cell(c.x, c.y - 1)) }
  if c.y < side - 1 { out.fixed_push(Cell(c.x, c.y + 1)) }
  return out.len
}

// One bit for each cell of the board.
data visited = mut [0:u32; side * side / 32]

// The bit of a cell of the board, row by row.
func bit(c: Cell) -> u32#(side * side) => ((c.y * side + c.x) as u32) % (side * side)

// How many cells a walk of `steps` steps sees, x going up by 7 and y by 3 at
// each step and wrapping at the edge. The walk goes into a Vec, which grows
// as long as the caller asks, and each cell it reaches is marked in visited.
export func walk(steps: u32) -> u32 {
  let scope = mark()
  defer reset(scope)
  let path = vec(Cell, 4)
  for i in steps {
    let c = Cell(((i * 7) % side) as i32, ((i * 3) % side) as i32)
    path.push(c)
    visited.set_bit(c.bit())
  }
  return visited.count_bits()
}

// The last moves, in a Ring laid out as data.
def kept = 8
data moves = mut [0:u32; kept]
data last_moves: Ring(kept, u32) = mut (0, 0, moves)

export func move(m: u32) { last_moves.record(m) }

// The oldest move the ring holds: once there have been eight, the eighth last.
export func eighth_last() -> u32 => last_moves.oldest(0)

test "neighbours" {
  assert neighbours(Cell(0, 0)) == 2
  assert neighbours(Cell(5, 0)) == 3
  assert neighbours(Cell(5, 5)) == 4
  assert neighbours(Cell(side - 1, side - 1)) == 2
}

test "a walk, and the cells it saw" {
  assert walk(16) == 16
}

test "the last eight moves" {
  for m in 20 {
    move(m)
  }
  assert eighth_last() == 12
}
