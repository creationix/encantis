// Writes val in decimal into buf, and returns the part of buf it wrote: a '-'
// for a negative number, the whole part, then a '.' and as many digits of the
// fraction as fit, cut off rather than rounded. A fraction too small to show
// in the digits that fit is left out, and so is one of zero. Where buf is too
// short the text is cut off at its end. The whole part is converted to a u64,
// so an infinity, NaN or a value of 2^64 or more traps.
export func write-float(buf: []mut u8, val: f64) -> []u8 {
  let i: u32 = 0
  // Each write through the many-pointer comes after a check of i against
  // buf.len.
  let ptr = buf.ptr

  if val < 0.0 {
    return ptr[..0] when buf.len == 0
    ptr[i] = '-'
    i += 1
    val = -val
  }

  let whole = u64(floor(val))
  let frac = val - f64(whole)

  // The whole part
  if whole == 0 {
    return ptr[..i] when i >= buf.len
    ptr[i] = '0'
    i += 1
  } else {
    // The highest power of 10 in whole, to write its digits first to last
    let pow: u64 = 1
    let tmp = whole
    while tmp >= 10 {
      pow *= 10
      tmp /= 10
    }
    while pow > 0 {
      return ptr[..i] when i >= buf.len
      ptr[i] = u8(whole / pow) + '0'
      i += 1
      whole %= pow
      pow /= 10
    }
  }

  // The fraction
  if frac > 0.0 {
    return ptr[..i] when i >= buf.len
    // The smallest fraction the room after the '.' can show: 10^-digits
    let precision = 1.0
    for j in buf.len - i - 1 {
      precision *= 0.1
    }
    if frac >= precision {
      ptr[i] = '.'
      i += 1
      while i < buf.len && frac >= precision {
        frac *= 10.0
        let d = u8(floor(frac))
        ptr[i] = d + '0'
        i += 1
        frac -= f64(d)
      }
    }
  }

  return ptr[..i]
}

test "write-float" {
  import "./strcmp" "strcmp" func strcmp(a: []u8, b: []u8) -> i32

  // Most tests write into these 20 bytes; the tests of short and empty buffers
  // make their own.
  data out = mut [0:u8; 20]

  test "an exact binary fraction is written in full" {
    assert strcmp(write-float(out, 0.5), "0.5") == 0
    assert strcmp(write-float(out, 0.25), "0.25") == 0
    assert strcmp(write-float(out, 0.125), "0.125") == 0
    assert strcmp(write-float(out, 1.5), "1.5") == 0
    assert strcmp(write-float(out, 1.5625), "1.5625") == 0
    assert strcmp(write-float(out, 3.375), "3.375") == 0
  }

  test "a whole number is written without a fraction" {
    assert strcmp(write-float(out, 0.0), "0") == 0
    assert strcmp(write-float(out, 1.0), "1") == 0
    assert strcmp(write-float(out, 5.0), "5") == 0
    assert strcmp(write-float(out, 42.0), "42") == 0
    assert strcmp(write-float(out, 1000.0), "1000") == 0
  }

  test "a negative value starts with -" {
    assert strcmp(write-float(out, -1.0), "-1") == 0
    assert strcmp(write-float(out, -0.5), "-0.5") == 0
    assert strcmp(write-float(out, -3.375), "-3.375") == 0
  }

  test "a large whole number is written in full" {
    assert strcmp(write-float(out, 99999.0), "99999") == 0
    assert strcmp(write-float(out, 1000000.0), "1000000") == 0
    assert strcmp(write-float(out, -99999.5), "-99999.5") == 0
    assert strcmp(write-float(out, 18446744073709549568.0), "18446744073709549568") == 0
  }

  test "negative zero is written as 0" {
    assert strcmp(write-float(out, -0.0), "0") == 0
  }

  test "a short buffer cuts the text off at its end" {
    // tiny buffers
    let b1: []mut u8 = mut [0:u8; 1]
    assert strcmp(write-float(b1, 5.0), "5") == 0
    assert strcmp(write-float(b1, 99.0), "9") == 0
    assert strcmp(write-float(b1, -3.0), "-") == 0
    let b2: []mut u8 = mut [0:u8; 2]
    assert strcmp(write-float(b2, 3.1), "3") == 0
    assert strcmp(write-float(b2, 3.5), "3") == 0
    assert strcmp(write-float(b2, -5.0), "-5") == 0
    assert strcmp(write-float(b2, -123.0), "-1") == 0
    assert strcmp(write-float(b2, 999.0), "99") == 0

    // 3-byte buffer: one digit fits after "3."; after "42" a '.' would leave no
    // room for one, so it is left out
    let b3: []mut u8 = mut [0:u8; 3]
    assert strcmp(write-float(b3, 3.14), "3.1") == 0
    assert strcmp(write-float(b3, 42.5), "42") == 0
    assert strcmp(write-float(b3, 123.0), "123") == 0

    // 4-byte buffer
    let b4: []mut u8 = mut [0:u8; 4]
    assert strcmp(write-float(b4, 3.14), "3.14") == 0
    assert strcmp(write-float(b4, 12.34), "12.3") == 0
    assert strcmp(write-float(b4, -1.5), "-1.5") == 0
    assert strcmp(write-float(b4, -42.0), "-42") == 0
    assert strcmp(write-float(b4, 3.14159), "3.14") == 0     // cut off, not rounded
    assert strcmp(write-float(b4, 0.001), "0") == 0          // below 0.01, the smallest two digits show

    // 6-byte buffer
    let b6: []mut u8 = mut [0:u8; 6]
    assert strcmp(write-float(b6, 3.14), "3.14") == 0
    assert strcmp(write-float(b6, 0.1), "0.1") == 0
    assert strcmp(write-float(b6, 0.025), "0.025") == 0
    assert strcmp(write-float(b6, 0.01), "0.01") == 0
    assert strcmp(write-float(b6, -3.14), "-3.14") == 0

    // 8-byte buffer
    let b8: []mut u8 = mut [0:u8; 8]
    assert strcmp(write-float(b8, 123.456), "123.456") == 0
    assert strcmp(write-float(b8, -3.14), "-3.14") == 0
    assert strcmp(write-float(b8, 0.03125), "0.03125") == 0

    // 10-byte buffer, the size trig.ents writes with
    let b10: []mut u8 = mut [0:u8; 10]
    assert strcmp(write-float(b10, 3.14), "3.14") == 0
    assert strcmp(write-float(b10, -123.456), "-123.456") == 0
    assert strcmp(write-float(b10, 0.00390625), "0.00390625") == 0
  }

  test "an empty buffer gets nothing written" {
    let b0: []mut u8 = mut []
    assert write-float(b0, 1.5).len == 0
    assert write-float(b0, -1.5).len == 0
  }
}
