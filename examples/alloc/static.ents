// Static reservation: the program owns a buffer of a size fixed when it is
// compiled, laid out as data, and hands out pieces of it by bumping a cursor.
// It needs no heap, since nothing is freed piece by piece: reset frees all.

export "mem" memory

data buf = mut [0:u8; 4096]

// What reserve gives when the bytes asked for do not fit.
def no_room = 0xFFFFFFFF:u32

global cursor: u32 = 0

// Reserves size bytes: their offset into buf, or no_room. cursor is never
// past buf.len, so buf.len - cursor does not wrap, where cursor + size can.
export func reserve(size: u32) -> (offset: u32) {
  return no_room when size > buf.len - cursor
  offset = cursor
  cursor += size
}

// Frees every reservation.
export func reset() {
  cursor = 0
}

// How many bytes are reserved.
export func used() -> u32 => cursor

// Writes a byte at an offset into buf; an offset past its end writes nothing.
export func write(offset: u32, value: u8) {
  return when offset >= buf.len
  buf[offset] = value
}

// The byte at an offset into buf, or 0 past its end.
export func read(offset: u32) -> u8 => buf[offset] ?? 0

test "reserve and read write" {
  assert used() == 0
  let first = reserve(16)
  assert used() == 16
  let second = reserve(32)
  assert second == 16
  assert used() == 48
  write(first, 42)
  write(first + 1, 99)
  assert read(first) == 42
  assert read(first + 1) == 99
  reset()
  assert used() == 0
}

test "overflow" {
  reset()
  reserve(4000)
  assert reserve(200) == no_room
  assert used() == 4000
  assert reserve(96) == 4000
  assert used() == buf.len
}

test "a size that would wrap the cursor does not fit" {
  reset()
  reserve(16)
  assert reserve(0xFFFFFFF0) == no_room
  assert used() == 16
}

test "nothing is read or written past the buffer" {
  write(buf.len, 7)
  assert read(buf.len) == 0
  write(buf.len - 1, 7)
  assert read(buf.len - 1) == 7
}
