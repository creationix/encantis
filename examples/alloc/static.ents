// Static reservation pattern: fixed-size mutable buffer
// No allocator needed — the program owns N bytes at a known offset.

export "mem" memory

data buf = mut [0:u8; 4096]

global cursor: u32 = 0

// Reserve `size` bytes, returns offset into buffer or 0xFFFFFFFF on overflow
export func reserve(size: u32) -> (offset: u32) {
  return 0xFFFFFFFF when cursor + size > 4096
  offset = cursor
  cursor += size
}

// Reset the buffer (all reservations become invalid)
export func reset() {
  cursor = 0
}

// How many bytes are in use
export func used() -> u32 => cursor

// Write a byte into the buffer
export func write(offset: u32, value: u8) {
  buf.u8[offset] = value
}

// Read a byte from the buffer
export func read(offset: u32) -> u8 => buf.u8[offset]

test "reserve and read write" {
  assert used() == 0
  let off1 = reserve(16)
  assert used() == 16
  let off2 = reserve(32)
  assert off2 == 16
  assert used() == 48
  write(off1, 42)
  write(off1 + 1, 99)
  assert read(off1) == 42
  assert read(off1 + 1) == 99
  reset()
  assert used() == 0
}

test "overflow" {
  reset()
  reserve(4000)
  assert reserve(200) == 0xFFFFFFFF
  assert used() == 4000
}
