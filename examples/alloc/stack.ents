// A bump stack freed by scope with defer: allocation is a pointer bump, and a
// scope frees everything it allocated by resetting to a mark on every exit.

data space = mut [0:u8; 65536]
global top: u32 = 0
data trace = mut [0:u8; 256]
global traced: u32 = 0

// What alloc gives when the bytes asked for do not fit.
def no_room = 0xFFFFFFFF:u32

// The top of the stack, as an offset into space.
export func mark() -> u32 => top

// Frees everything allocated since the mark m was taken.
export func reset(m: u32) {
  top = m
}

// The address of n bytes, or no_room when they do not fit in what is left of
// space. top stays a multiple of 8, and space is the first data, at address 8,
// so the address is a multiple of 8 too.
export func alloc(n: u32) -> u32 {
  let size = (n + 7) & ~7          // wraps only for an n past space.len
  return no_room when n > space.len || size > space.len - top
  let p = (space as u32) + top
  top += size
  return p
}

func note(n: u32) {
  trace.u32[traced] = n
  traced += 1
}

// The sum of 0 to n - 1, through a scratch array on the stack: nothing
// outlives the call.
export func sum_scratch(n: u32) -> u32 {
  let m = mark()
  defer reset(m)
  return 0 when n == 0
  return 0 when n > space.len / sizeof(u32)
  let p = alloc(n * sizeof(u32))
  return 0 when p == no_room
  let a = p as [*]mut u32
  for i in n {
    a[i] = i
  }
  let s: u32 = 0
  for i in n {
    s += a[i]
  }
  return s
}

// Records the order deferred expressions run in: on every way out of a block,
// newest first.
export func order(x: u32) -> u32 {
  note(1)
  defer note(100)
  return 7 when x == 0
  defer note(200)
  for i in 4 {
    defer note(11 + i)
    continue when i == 0
    break when i == 2
    note(21 + i)
  }
  loop {
    defer note(300)
    return 9 when x == 9
    break
  }
  return x * 2
}

// Whether the notes since traced was set to 0 are these, in this order.
func traced_is(expected: []u32) -> bool {
  return false when traced != expected.len
  for i, n in expected {
    return false when trace.u32[i] != n
  }
  return true
}

test "a scope frees what it allocated on every return" {
  let before = mark()
  assert sum_scratch(10) == 45
  assert mark() == before
  assert sum_scratch(0) == 0
  assert mark() == before
}

test "an early return runs only the defers reached" {
  traced = 0
  assert order(0) == 7
  assert traced_is([1, 100])
}

test "break, continue and return run the blocks they leave, newest first" {
  traced = 0
  assert order(5) == 10
  assert traced_is([1, 11, 22, 12, 13, 300, 200, 100])
  traced = 0
  assert order(9) == 9
  assert traced_is([1, 11, 22, 12, 13, 300, 200, 100])
}

test "alloc refuses requests that overflow the space" {
  let m = mark()
  assert alloc(space.len + 1) == no_room
  assert alloc(space.len) != no_room
  assert alloc(1) == no_room
  reset(m)
  assert sum_scratch(space.len / sizeof(u32) + 1) == 0
  assert mark() == m
}
