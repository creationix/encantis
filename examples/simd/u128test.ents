// u128 test harness — uses memory I/O since v128 can't cross JS boundary
export "mem" memory 1

// Read u128 from memory at byte offset
func load(offset: u32) -> u128 {
  let p = offset as *u128
  return p.*
}

// Write u128 to memory at byte offset
func store(offset: u32, val: u128) {
  let p = offset as *mut u128
  p.* = val
}

// Operations: read inputs from memory, write result to memory
// Input A at offset 0, Input B at offset 16, Result at offset 32

export func test_xor() { store(32, load(0) ^ load(16)) }
export func test_add() { store(32, load(0) + load(16)) }
export func test_and() { store(32, load(0) & load(16)) }
export func test_or()  { store(32, load(0) | load(16)) }
export func test_not() { store(32, ~load(0)) }
export func test_eq() -> bool => load(0) == load(16)

export func test_widen(val: u64) { store(32, val as u128) }
export func test_narrow() -> u64 => load(0) as u64

export func test_mul_hi(a: u64, b: u64) -> u64 => mul_hi(a, b)
