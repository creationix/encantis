// A ring buffer (a circular queue) of bytes: push adds at the tail, pop takes
// from the head, and both wrap at the end of the buffer. head and tail are
// ranged globals, below the capacity, so every index is proven and compiles
// to a plain load or store.

export "mem" memory

def capacity = 256

data buf = mut [0:u8; capacity]

global head: u32#capacity = 0
global tail: u32#capacity = 0
global count: u32 = 0

// Adds a byte at the tail; false, with nothing changed, when the buffer is full.
export func push(value: u8) -> bool {
  return false when count >= capacity
  buf[tail] = value
  tail = (tail + 1) % capacity
  count += 1
  return true
}

// Takes the byte at the head, or 0 when the buffer is empty.
export func pop() -> (value: u8) {
  return 0 when count == 0
  value = buf[head]
  head = (head + 1) % capacity
  count -= 1
}

// The byte at the head, left in place, or 0 when the buffer is empty.
export func peek() -> u8 {
  return 0 when count == 0
  return buf[head]
}

export func size() -> u32 => count
export func is-empty() -> bool => count == 0
export func is-full() -> bool => count >= capacity

func reset() {
  head = 0
  tail = 0
  count = 0
}

test "ring buffer" {

  test "push and pop FIFO" {
    reset()
    push(10)
    push(20)
    push(30)
    assert size() == 3
    assert pop() == 10
    assert pop() == 20
    assert pop() == 30
    assert is-empty()
  }

  test "peek does not consume" {
    reset()
    push(42)
    assert peek() == 42
    assert peek() == 42
    assert size() == 1
  }

  test "wraparound" {
    reset()
    // Fill and drain to advance head and tail past the middle
    for i in 200 {
      push(i as u8)
    }
    for i in 200 {
      pop()
    }
    assert is-empty()
    // Now push again: this wraps around the end of the buffer
    for i in 100 {
      push((i + 50) as u8)
    }
    assert size() == 100
    assert pop() == 50       // the first pushed
  }

  test "full rejects push" {
    reset()
    for i in capacity {
      assert push(i as u8)
    }
    assert is-full()
    assert !push(99)
    assert size() == capacity
  }

  test "empty pop returns zero" {
    reset()
    assert pop() == 0
    assert is-empty()
  }
}
