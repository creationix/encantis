// A trie packed into 64-bit words, walked 6 bits of the key at a time.
//
// A node is a bitfield, a word with bit s set for each 6-bit symbol s that has
// a child, followed by one entry for each set bit, in the order of the bits:
// popcnt of the bits below s counts the entries before s's. An entry is a
// tagged word. With its low bit 1 it points to another node, at the word
// index entry >> 1; with its low bit 0 it is a leaf, the value found, whose
// 63 bits above the tag are its payload.
//
// The symbol at depth d is the 6 bits of the key from bit (6 * d) % 64 up
// (fewer where they pass the top bit).

// The leaf the key leads to; -1 when the key is not in the trie, and -2 when
// a node or an entry would lie past its end.
export func walk-trie(trie: []u64, key: u64) -> i64 {
  let at: u32 = 0               // the node's word index
  let shift: u8 = 0             // where the symbol starts in the key
  loop {
    let bits = if let w = trie[at] { w } else { return -2 }
    let bit = 1:u64 << ((key >> shift) & 0x3f)
    shift = (shift + 6) % 64
    return -1 when bits & bit == 0
    let entry = if let w = trie[at + 1 + popcnt(bits & (bit - 1))] { w } else { return -2 }
    return entry as i64 when entry & 1 == 0
    at = (entry >> 1) as u32
  }
}

test "walk-trie" {
  // A root with symbols 1 and 5: 1 is the leaf 10, 5 the node at word 3,
  // whose symbol 2 is the leaf 84.
  data sample = [0x22:u64, 10, (3 << 1) | 1, 0x4, 84]

  test "a key is walked to its leaf" {
    assert walk-trie(sample, 1) == 10
    assert walk-trie(sample, 5 | 2 << 6) == 84
  }

  test "a symbol with no child is not found" {
    assert walk-trie(sample, 3) == -1
    assert walk-trie(sample, 5) == -1        // symbol 0 below node 3
  }

  test "an entry past the end of the trie" {
    assert walk-trie([], 1) == -2
    assert walk-trie([0x22:u64], 1) == -2
    assert walk-trie([0x22:u64, 10, 101], 5 | 2 << 6) == -2
  }
}
