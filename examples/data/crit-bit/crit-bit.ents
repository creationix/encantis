/*
 * Crit-Bit Tree (Critical Bit Tree)
 * ==================================
 *
 * A crit-bit tree is a compact binary trie optimized for storing strings or
 * binary keys. It's a variant of a PATRICIA trie with exactly two types of nodes:
 *
 *   - Internal nodes: Store only a "critical bit" position - the bit index where
 *     two keys first differ. Has left child (bit=0) and right child (bit=1).
 *
 *   - External nodes: Store the actual key (leaf nodes).
 *
 * Key properties:
 *
 *   - Space efficient: Internal nodes store only a bit position, not key prefixes.
 *     For n keys, there are exactly n external nodes and n-1 internal nodes.
 *
 *   - Time efficient: Lookup, insert, and delete are O(k) where k is key length
 *     in bits. No key comparisons during tree traversal - just bit tests.
 *
 *   - Ordered: In-order traversal yields keys in lexicographic order, enabling
 *     efficient range queries and prefix searches.
 *
 *   - Cache friendly: Small internal nodes mean more fit in cache during traversal.
 *
 * How lookup works:
 *
 *   1. Start at root, traverse down testing the critical bit at each internal node
 *   2. Go left if bit is 0, right if bit is 1
 *   3. Reach an external node containing a candidate key
 *   4. Compare the full key - if it matches, found; otherwise, key not present
 *
 * How insert works:
 *
 *   1. Traverse tree to find the best candidate leaf
 *   2. Compare new key with candidate to find first differing bit position
 *   3. Walk down again from the root to the insertion point: above the first
 *      node that tests a later bit
 *   4. Insert new internal node at that position with new leaf as child
 *
 * Example tree storing {"a", "aa", "b"}, with bits numbered from the high bit
 * of the first byte and a missing byte read as zero bits:
 *
 *              [bit 6]           <- root: test bit 6
 *              /     \
 *         [bit 9]     "b"        <- left subtree, right is leaf "b"
 *         /     \
 *       "a"     "aa"             <- leaves
 *
 * Bit 6 is the first bit where 'a' (0x61 = 0110 0001) and 'b' (0x62 =
 * 0110 0010) differ. Bit 9, the second bit of the second byte, separates "a"
 * (no second byte) from "aa" (0x61). crit-bit.md works through this example.
 *
 * References:
 *   - D.J. Bernstein's crit-bit paper: https://cr.yp.to/critbit.html
 *   - Adam Langley's implementation notes
 */

// === Implementation ===
//
// This follows Bernstein's crit-bit code, adapted for byte slices that can be
// prefixes of each other ("a" and "a\x00" are different keys): byte i of a key is
// read as a 9-bit symbol, 0x100 | byte when i < len and 0 past the end, so the
// end of a key sorts before any byte. An internal node records the byte index
// where its two subtrees first differ, and `otherbits`, a 9-bit mask with every
// bit set except the critical one. The direction for symbol c is then
// (1 + (otherbits | c)) >> 9: 1 if c has the critical bit, 0 if not.
//
// Nodes live in `pool`, addressed in 32-bit words through its u32 view, which
// checks no index: every index is that of a node, which alloc keeps inside the
// pool. A node reference is the word index shifted left one bit, with the low
// bit set for an external node; 0 is the empty tree.
//
//   internal node, 4 words: byte, otherbits, child 0, child 1
//   external node, 2 words: key ptr, key len
//
// The tree stores keys by reference: they must outlive it. Freed nodes are not
// reused; `clear` empties the tree and the pool.

data pool = mut [0:u8; 65536]
global used: u32 = 1  // word 0 stays unused, so no node has reference 0
global root: u32 = 0
global count: u32 = 0

// A node of `words` words, or 0 when the pool is full.
func alloc(words: u32) -> u32 {
  return 0 when used + words > pool.len / sizeof(u32)
  let at = used
  used += words
  return at
}

func is_external(node: u32) -> bool => node & 1 == 1
func index(node: u32) -> u32 => node >> 1

// The key an external node holds.
func key_of(leaf: u32) -> []u8 {
  let q = index(leaf)
  return (pool.u32[q] as [*]u8, pool.u32[q + 1])
}

// Symbol i of a key: 0x100 | key[i], or 0 past the end.
func symbol(key: []u8, i: u32) -> u32 => if let b = key[i] { 0x100 | b:u32 } else { 0 }

func direction(otherbits: u32, c: u32) -> u32 => (1 + (otherbits | c)) >> 9

// The first index at which the symbols of two keys differ: at most the longer
// length, where only one of them, or for equal keys neither, has a byte.
func first_difference(a: []u8, b: []u8) -> u32 {
  let end = max(a.len, b.len)
  for i in end {
    return i when symbol(a, i) != symbol(b, i)
  }
  return end
}

// The word index of the child slot an internal node takes for a key.
func child_slot(node: u32, key: []u8) -> u32 {
  let q = index(node)
  let c = symbol(key, pool.u32[q])
  return q + 2 + direction(pool.u32[q + 1], c)
}

// The external node a search for this key ends at (the tree must be nonempty).
func best_match(key: []u8) -> u32 {
  let p = root
  while !is_external(p) {
    p = pool.u32[child_slot(p, key)]
  }
  return p
}

// Whether two keys hold the same bytes.
func same(a: []u8, b: []u8) -> bool {
  return false when a.len != b.len
  for i in a.len {                         // a count, since i indexes both
    return false when a.ptr[i] != b.ptr[i]  // b is as long as a
  }
  return true
}

// Whether the tree holds this key.
export func contains(key: []u8) -> bool {
  return false when root == 0
  return same(key_of(best_match(key)), key)
}

// Add a key. Returns false when it was already there or the pool is full.
export func insert(key: []u8) -> bool {
  if root == 0 {
    let only = alloc(2)
    return false when only == 0
    pool.u32[only] = key.ptr as u32
    pool.u32[only + 1] = key.len
    root = (only << 1) | 1
    count = 1
    return true
  }

  // The first symbol where the key differs from its best match.
  let best = key_of(best_match(key))
  let newbyte = first_difference(key, best)
  let diff = symbol(key, newbyte) ^ symbol(best, newbyte)
  return false when diff == 0

  // Every bit but the highest that differs.
  let newotherbits = (0x80000000:u32 >> clz(diff)) ^ 0x1FF
  let newdirection = direction(newotherbits, symbol(best, newbyte))

  let leaf = alloc(2)
  return false when leaf == 0
  let node = alloc(4)
  return false when node == 0
  pool.u32[leaf] = key.ptr as u32
  pool.u32[leaf + 1] = key.len
  pool.u32[node] = newbyte
  pool.u32[node + 1] = newotherbits
  pool.u32[node + 3 - newdirection] = (leaf << 1) | 1

  // Walk down again to where the new node belongs: above the first node that
  // tests a later byte, or a lower bit of the same byte.
  let slot: u32 = 0  // 0 means root
  let p = root
  loop {
    break when is_external(p)
    let q = index(p)
    break when pool.u32[q] > newbyte
    break when pool.u32[q] == newbyte && pool.u32[q + 1] > newotherbits
    slot = child_slot(p, key)
    p = pool.u32[slot]
  }
  pool.u32[node + 2 + newdirection] = p
  if slot == 0 {
    root = node << 1
  } else {
    pool.u32[slot] = node << 1
  }
  count += 1
  return true
}

// Remove a key. Returns false when it wasn't there.
export func delete(key: []u8) -> bool {
  return false when root == 0

  // Track the slot holding p and the internal node above it.
  let slot: u32 = 0
  let parent: u32 = 0
  let parent_slot: u32 = 0
  let p = root
  while !is_external(p) {
    parent_slot = slot
    parent = p
    slot = child_slot(p, key)
    p = pool.u32[slot]
  }
  return false when !same(key_of(p), key)

  count -= 1
  if parent == 0 {
    root = 0
    return true
  }
  // Replace the parent with p's sibling.
  let q = index(parent)
  let sibling = pool.u32[q + 2 + (q + 3 - slot)]
  if parent_slot == 0 {
    root = sibling
  } else {
    pool.u32[parent_slot] = sibling
  }
  return true
}

export func size() -> u32 => count

// The smallest key. The tree must not be empty: on an empty tree, first traps.
export func first() -> []u8 {
  assert root != 0
  let p = root
  while !is_external(p) {
    p = pool.u32[index(p) + 2]
  }
  return key_of(p)
}

// Empty the tree and its node pool.
export func clear() {
  root = 0
  count = 0
  used = 1
}

test "insert and contains" {
  clear()
  assert insert("b")
  assert insert("a")
  assert insert("aa")
  assert insert("")
  assert !insert("a")
  assert size() == 4
  assert contains("a")
  assert contains("aa")
  assert contains("b")
  assert contains("")
  assert !contains("ab")
  assert !contains("c")
}

test "keys that are prefixes of each other stay distinct" {
  clear()
  assert insert("a")
  assert insert("a\x00")
  assert insert("a\x00\x00")
  assert contains("a\x00")
  assert !contains("a\x00\x00\x00")
  assert size() == 3
}

test "delete" {
  clear()
  assert insert("apple")
  assert insert("banana")
  assert insert("cherry")
  assert !delete("grape")
  assert delete("banana")
  assert !contains("banana")
  assert contains("apple")
  assert contains("cherry")
  assert delete("apple")
  assert delete("cherry")
  assert size() == 0
  assert !contains("cherry")
  assert insert("cherry")
  assert contains("cherry")
}

test "first is the smallest key" {
  clear()
  assert insert("pear")
  assert insert("fig")
  assert insert("plum")
  assert insert("figs")
  let k = first()
  assert k.len == 3
  assert (k[0] ?? 0) == 'f'
}

test "many keys, half deleted" {
  clear()
  assert insert("alpha")
  assert insert("alphabet")
  assert insert("alp")
  assert insert("beta")
  assert insert("bet")
  assert insert("gamma")
  assert insert("gam")
  assert insert("delta")
  assert insert("epsilon")
  assert insert("eps")
  assert insert("zeta")
  assert insert("z")
  assert size() == 12
  assert delete("alphabet")
  assert delete("bet")
  assert delete("gamma")
  assert delete("eps")
  assert delete("z")
  assert delete("delta")
  assert size() == 6
  assert contains("alpha")
  assert contains("alp")
  assert contains("beta")
  assert contains("gam")
  assert contains("epsilon")
  assert contains("zeta")
  assert !contains("alphabet")
  assert !contains("bet")
  assert !contains("gamma")
  assert !contains("eps")
  assert !contains("z")
  assert !contains("delta")
  let k = first()
  assert k.len == 3
}
