#!/usr/bin/env encantis run
// Advent of Code 2023, day 1, part 1: on each line, the first and last digits
// make a two-digit number; print the sum of those numbers.
// Usage: encantis run day1.ents < input.txt

import "../../lib/io" (
  "read_all" func read_all(buf: []mut u8) -> []u8
  "print_u64" func print_u64(n: u64)
)
import "../../lib/text" (
  "next_line" func next_line(s: []u8) -> (line: []u8, rest: []u8)
)

export memory

data input = mut [0:u8; 65536]

// The two-digit number of a line's first and last digits, or 0 for a line
// with no digit.
func calibration(line: []u8) -> u64 {
  let first: u64 = 0
  let last: u64 = 0
  let seen = false
  for c in line {
    continue when c < '0' || c > '9'
    let d = c - '0'
    if !seen {
      first = d
      seen = true
    }
    last = d
  }
  return first * 10 + last
}

// The sum of the calibrations of the lines of text.
func total(text: []u8) -> u64 {
  let sum: u64 = 0
  let rest = text
  while rest.len > 0 {
    let (line:, rest: after) = next_line(rest)
    sum += calibration(line)
    rest = after
  }
  return sum
}

export "_start" func main() {
  print_u64(total(read_all(input)))
}

test "the example from the puzzle" {
  assert total("1abc2\npqr3stu8vwx\na1b2c3d4e5f\ntreb7uchet\n") == 142
}

test "no trailing newline, and lines with no digits" {
  assert total("a1\nxyz\n9") == 11 + 99
}

test "a 0 is a digit like any other" {
  assert total("0ab7\n80\n0\n") == 7 + 80 + 0
}
