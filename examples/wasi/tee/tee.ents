#!/usr/bin/env encantis run
// Poor man's tee — outputs to stderr and stdout whatever comes in stdin
// Usage: echo "hello" | ./tee.ents

import "wasi_snapshot_preview1" (
  "fd_read" func wasi_fd_read(fd:i32, iovs:[][]u8, nread:*mut u32) -> i32
  "fd_write" func wasi_fd_write(fd:i32, iovs:[][]u8, nwritten:*mut u32) -> i32
)

export memory

def stdin = 0:i32
def stdout = 1:i32
def stderr = 2:i32

export "_start" func main() {
  let nread = &0:u32
  let nwritten = &0:u32
  let iovecs:[][]u8 = mut [[0:u8;1024]]
  loop {
    let res = wasi_fd_read(stdin, iovecs, nread)
    break when res != 0
    break when nread.* == 0

    set res = wasi_fd_write(stdout, iovecs, nwritten)
    break when res != 0

    set res = wasi_fd_write(stderr, iovecs, nwritten)
    break when res != 0
  }
}
