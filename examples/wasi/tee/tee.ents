#!/usr/bin/env encantis run
// A tee to standard error: copies standard input to standard output and to
// standard error. A WASI error is reported on standard error and ends the
// program, with the error's code as its exit status.
// Usage: echo "hello" | ./tee.ents

import "wasi_snapshot_preview1" (
  "fd_read" func fd_read(fd: i32, iovs: [][]mut u8, nread: *mut u32) -> i32
  "fd_write" func fd_write(fd: i32, iovs: [][]u8, nwritten: *mut u32) -> i32
  "proc_exit" func proc_exit(code: i32)
)

export memory

def stdin = 0:i32
def stdout = 1:i32
def stderr = 2:i32

// The names of WASI's error codes, by code.
data errnos = [
  "ESUCCESS", "E2BIG", "EACCES", "EADDRINUSE", "EADDRNOTAVAIL",
  "EAFNOSUPPORT", "EAGAIN", "EALREADY", "EBADF", "EBADMSG",
  "EBUSY", "ECANCELED", "ECHILD", "ECONNABORTED", "ECONNREFUSED", "ECONNRESET",
  "EDEADLK", "EDESTADDRREQ", "EDOM", "EDQUOT", "EEXIST",
  "EFAULT", "EFBIG", "EHOSTUNREACH", "EIDRM", "EILSEQ",
  "EINPROGRESS", "EINTR", "EINVAL", "EIO", "EISCONN",
  "EISDIR", "ELOOP", "EMFILE", "EMLINK", "EMSGSIZE",
  "EMULTIHOP", "ENAMETOOLONG", "ENETDOWN", "ENETRESET", "ENETUNREACH",
  "ENFILE", "ENOBUFS", "ENODEV", "ENOENT", "ENOEXEC",
  "ENOLCK", "ENOLINK", "ENOMEM", "ENOMSG", "ENOPROTOOPT",
  "ENOSPC", "ENOSYS", "ENOTCONN", "ENOTDIR", "ENOTEMPTY",
  "ENOTRECOVERABLE", "ENOTSOCK", "ENOTSUP", "ENOTTY", "ENXIO",
  "EOVERFLOW", "EOWNERDEAD", "EPERM", "EPIPE", "EPROTO",
  "EPROTONOSUPPORT", "EPROTOTYPE", "ERANGE", "EROFS", "ESPIPE",
  "ESRCH", "ESTALE", "ETIMEDOUT", "ETXTBSY", "EXDEV",
  "ENOTCAPABLE"
]

data buffer = mut [0:u8; 0x4000]

func errno_name(code: i32) -> []u8 => errnos[code] ?? "UNKNOWN"

// Reports a WASI error on standard error and exits with its code; nothing
// for 0, which is no error.
func try(msg: []u8, code: i32) {
  return when code == 0
  fd_write(stderr, `Error ${msg}: ${errno_name(code)}\n`, &0)
  proc_exit(code)
}

// Writes all of bytes to fd, in as many calls as that takes: 0, or the error
// code of the call that failed.
func write_all(fd: i32, bytes: []u8) -> i32 {
  let left = bytes
  let written = &0:u32
  let iov: *mut [1][]u8 = mut [bytes]
  while left.len > 0 {
    iov[0] = left
    let err = fd_write(fd, iov, written)
    return err when err != 0
    left = left[written.*..] ?? ""
  }
  return 0
}

export "_start" func main() {
  let nread = &0:u32
  let iov: *mut [1][]mut u8 = mut [buffer]
  loop {
    try("reading from stdin", fd_read(stdin, iov, nread))
    break when nread.* == 0
    let chunk = buffer[..nread.*] ?? buffer
    try("writing to stdout", write_all(stdout, chunk))
    // A write to standard error that fails cannot be reported there.
    let err = write_all(stderr, chunk)
    if err != 0 { proc_exit(err) }
  }
}

test "the names of error codes" {
  import "../../../lib/text" "eq" func eq(a: []u8, b: []u8) -> bool
  assert eq(errno_name(8), "EBADF")
  assert eq(errno_name(76), "ENOTCAPABLE")
  assert eq(errno_name(77), "UNKNOWN")
  assert eq(errno_name(-1), "UNKNOWN")
}

test "write_all gives the code of a write that fails" {
  assert write_all(stdout, "") == 0
  assert write_all(9, "x") == 8                // the test host's EBADF
}
