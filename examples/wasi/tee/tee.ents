// Poor man's tee
// Outputs to stderr and stdout whatever comes in stdin

import "wasi_snapshot_preview1" (
  "fd_read" func wasi_fd_read(fd:i32, iovs:[][]u8, nread:*u32) -> i32
  "fd_write" func wasi_fd_write(fd:i32, iovs:[][]u8, nwritten:*u32) -> i32
  "proc_exit" func wasi_proc_exit(code:i32)
)

def stdin = 0:i32
def stdout = 1:i32
def stderr = 2:i32

// def iovecs:[][]u8 = mut [[0:u8;1024]]

export "_start" func main() {
  let nread = &0:u32
  let nwritten = &0:u32
  // Define a single iovec with a buffer of 1024 bytes
  let iovecs:[][]u8 = mut [[0:u8;1024]]
  // Get reference to first iovec so we can update its length
  let iovec = &iovecs[0]
  loop {

    // Allow the full buffer to be filled on read
    iovec.len = 1024

    // Read up to buffer_len bytes from stdin
    // Pass slice containing single iovec: (&iovec, 1) coerces to [][]u8
    let res = wasi_fd_read(stdin, iovecs, nread)
    break when res != 0
    break when nread == 0

    // Update iovec length to actual bytes read
    iovec.len = nread.*

    // Write the bytes to stdout
    set res = wasi_fd_write(stdout, iovecs, nwritten)
    break when res != 0

    // Write the same bytes to stderr
    set res = wasi_fd_write(stderr, iovecs, nwritten)
    break when res != 0
  }
}
