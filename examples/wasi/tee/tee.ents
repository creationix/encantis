#!/usr/bin/env encantis run
// Poor man's tee — outputs to stderr and stdout whatever comes in stdin
// Usage: echo "hello" | ./tee.ents

import "wasi_snapshot_preview1" (
  "fd_read" func wasi_fd_read(fd:i32, iovs:[][]mut u8, nread:*mut u32) -> i32
  "fd_write" func wasi_fd_write(fd:i32, iovs:[][]u8, nwritten:*mut u32) -> i32
  "proc_exit" func wasi_proc_exit(code:i32)
)

export memory

def stdin = 0:i32
def stdout = 1:i32
def stderr = 2:i32

data errnos:[][]u8 = [
  "ESUCCESS", "E2BIG", "EACCES", "EADDRINUSE", "EADDRNOTAVAIL",
  "EAFNOSUPPORT", "EAGAIN", "EALREADY", "EBADF", "EBADMSG",
  "EBUSY", "ECANCELED", "ECHILD", "ECONNABORTED", "ECONNREFUSED", "ECONNRESET",
  "EDEADLK", "EDESTADDRREQ", "EDOM", "EDQUOT", "EEXIST",
  "EFAULT", "EFBIG", "EHOSTUNREACH", "EIDRM", "EILSEQ",
  "EINPROGRESS", "EINTR", "EINVAL", "EIO", "EISCONN",
  "EISDIR", "ELOOP", "EMFILE", "EMLINK", "EMSGSIZE",
  "EMULTIHOP", "ENAMETOOLONG", "ENETDOWN", "ENETRESET", "ENETUNREACH",
  "ENFILE", "ENOBUFS", "ENODEV", "ENOENT", "ENOEXEC",
  "ENOLCK", "ENOLINK", "ENOMEM", "ENOMSG", "ENOPROTOOPT",
  "ENOSPC", "ENOSYS", "ENOTCONN", "ENOTDIR", "ENOTEMPTY",
  "ENOTRECOVERABLE", "ENOTSOCK", "ENOTSUP", "ENOTTY", "ENXIO",
  "EOVERFLOW", "EOWNERDEAD", "EPERM", "EPIPE", "EPROTO",
  "EPROTONOSUPPORT", "EPROTOTYPE", "ERANGE", "EROFS", "ESPIPE",
  "ESRCH", "ESTALE", "ETIMEDOUT", "ETXTBSY", "EXDEV",
  "ENOTCAPABLE"
]

data err_iovecs:[]mut[]u8 = ["Error ", "", ": ", "", "\n"]

func try(msg: []u8, code: i32) {
  return when code == 0
  let nwritten = &0:u32
  err_iovecs[1] = msg
  err_iovecs[3] = errnos[code]
  wasi_fd_write(stderr, err_iovecs, nwritten)
  wasi_proc_exit(code)
}

// TODO: template literals — try2 would replace try
// func try2(msg: []u8, code: i32) {
//   return when code == 0
//   wasi_fd_write(stderr, `Error ${msg}: ${errnos[code]}\n`, &0)
//   wasi_proc_exit(code)
// }

export "_start" func main() {
  let nread = &0:u32
  let nwritten = &0:u32
  let iovecs:[]mut []mut u8 = [[0:u8; 1024]]
  // Remember the original offset so we can restore it later
  let buf_ptr = iovecs[0].ptr
  loop {
    try("reading from stdin", wasi_fd_read(stdin, iovecs, nread))
    break when nread.* == 0

    // Write all bytes to stdout
    iovecs[0].ptr = buf_ptr
    iovecs[0].len = nread.*
    loop {
      try("writing to stdout", wasi_fd_write(stdout, iovecs, nwritten))
      break when nwritten.* == iovecs[0].len
      iovecs[0].ptr = iovecs[0].ptr + nwritten.*
      iovecs[0].len = iovecs[0].len - nwritten.*
    }

    // Write all bytes to stderr
    iovecs[0].ptr = buf_ptr
    iovecs[0].len = nread.*
    loop {
      let res = wasi_fd_write(stderr, iovecs, nwritten)
      if res != 0 { wasi_proc_exit(res) }
      break when nwritten.* == iovecs[0].len
      iovecs[0].ptr = iovecs[0].ptr + nwritten.*
      iovecs[0].len = iovecs[0].len - nwritten.*
    }

    // Reset to original
    iovecs[0].ptr = buf_ptr
    iovecs[0].len = 1024
  }
}
