// A growable vector as a generic type, written with plain calls (methods.ents
// writes the same vector with method calls). The header lives in memory:
// `vec` returns a pointer to it, and `v.len` reads the field through the
// pointer.

data space = mut [0:u8; 4096]
global top: u32 = 0

// A bump allocator: n bytes of space, at an offset rounded up to a multiple
// of 8. It traps when space has no room for them.
func alloc(n: u32) -> (p: u32) {
  top = (top + 7) & ~7
  assert n <= space.len - top      // not top + n <= space.len, which can wrap
  p = (space as u32) + top
  top += n
}

func Vec(comptime T: type) -> type => (ptr: [*]mut T, len: u32, cap: u32)
func Pair(comptime A: type, comptime B: type) -> type => (first: A, second: B)

// An empty vector with room for cap elements, and for one at least, as push
// doubles the room.
func vec(comptime T: type, cap: u32) -> *mut Vec(T) {
  let room = max(cap, 1)
  let v = alloc(sizeof(Vec(T))) as *mut Vec(T)
  v.* = Vec(T)(alloc(room * sizeof(T)) as [*]mut T, 0, room)
  return v
}

// Adds x at the end, moving the elements to twice the room when it is full.
func push(comptime T: type, v: *mut Vec(T), x: T) {
  if v.len == v.cap {
    let moved = alloc(v.cap * 2 * sizeof(T)) as [*]mut T
    for i in v.len {
      moved[i] = v.ptr[i]
    }
    v.ptr = moved
    v.cap *= 2
  }
  v.ptr[v.len] = x
  v.len += 1
}

func get(comptime T: type, v: *Vec(T), i: u32) -> T {
  assert i < v.len
  return v.ptr[i]
}

func items(comptime T: type, v: *Vec(T)) -> []T => v.ptr[0..v.len]

func swapped(comptime A: type, comptime B: type, p: Pair(A, B)) -> Pair(B, A) => Pair(B, A)(p.second, p.first)

// The sum of 0 to n - 1, pushed onto a vector and read back. The space the
// vector takes is given back when it returns; a call that traps, for want of
// space, leaves it taken.
export func sum_to(n: u32) -> (s: u32) {
  let mark = top
  let v = vec(u32, 2)
  for i in n {
    push(v, i)
  }
  for x in items(v) {
    s += x
  }
  top = mark
}

test "a vec grows and keeps its elements" {
  let v = vec(u64, 2)
  for i in 10 {
    push(v, i * 3)
  }
  assert v.len == 10
  assert v.cap == 16
  assert get(v, 0) == 0
  assert get(v, 9) == 27
  assert items(v).len == 10
  assert sum_to(5) == 10
}

test "T is inferred through *mut Vec(T), or written" {
  let b = vec(u8, 4)
  push(b, 200)
  push(u8, b, 55)
  assert get(u8, b, 0) == 200
  assert get(b, 1) == 55
}

test "a struct with the same fields is a Vec" {
  let raw: *mut (ptr: [*]mut u16, len: u32, cap: u32) = vec(u16, 1)
  push(raw, 7)
  push(raw, 8)
  assert get(raw, 1) == 8
}

test "sizes and constructors follow the type arguments" {
  assert sizeof(Vec(u8)) == 12
  assert sizeof(Pair(u8, u64)) == 9
  let p = swapped(Pair(u8, u64)(1, 2))
  assert p.first == 2
  assert p.second == 1
}

test "sum_to gives back the space it takes" {
  let before = top
  for k in 1000 {
    assert sum_to(100) == 4950
  }
  assert top == before
  let none = vec(u32, 0)
  assert none.cap == 1
}
