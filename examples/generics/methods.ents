// Method-call syntax: x.f(args) is f(x, args) when x has no field f (vec.ents
// writes the same vector with plain calls). The receiver is passed as written
// (no implicit address-of), so the vector's header lives in memory and `vec`
// returns a pointer to it; `v.len` reads the field through the pointer.

data space = mut [0:u8; 4096]
global top: u32 = 0

// A bump allocator: n bytes of space, at an offset rounded up to a multiple
// of 8. Where space has no room for them it traps, and top stays as it was.
func alloc(n: u32) -> (p: u32) {
  let at = (top + 7) & ~7
  assert n <= space.len - at       // not at + n <= space.len, which can wrap
  p = (space as u32) + at
  top = at + n
}

// Gives back the space taken since top was mark.
func reset(mark: u32) { top = mark }

func Vec(comptime T: type) -> type => (ptr: [*]mut T, len: u32, cap: u32)

// An empty vector with room for cap elements, and for one at least, as push
// doubles the room.
func vec(comptime T: type, cap: u32) -> *mut Vec(T) {
  let room = max(cap, 1)
  assert room <= space.len / sizeof(T)   // so that room * sizeof(T) can't wrap
  let v = alloc(sizeof(Vec(T))) as *mut Vec(T)
  v.* = Vec(T)(alloc(room * sizeof(T)) as [*]mut T, 0, room)
  return v
}

// Adds x at the end, moving the elements to twice the room when it is full.
func push(comptime T: type, v: *mut Vec(T), x: T) {
  if v.len == v.cap {
    let moved = alloc(v.cap * 2 * sizeof(T)) as [*]mut T
    for i in v.len {
      moved[i] = v.ptr[i]
    }
    v.ptr = moved
    v.cap *= 2
  }
  v.ptr[v.len] = x
  v.len += 1
}

// Takes the last element off. Traps when there is none.
func pop(comptime T: type, v: *mut Vec(T)) -> T {
  assert v.len > 0
  v.len -= 1
  return v.ptr[v.len]
}

func get(comptime T: type, v: *Vec(T), i: u32) -> T {
  assert i < v.len
  return v.ptr[i]
}

func items(comptime T: type, v: *Vec(T)) -> []T => v.ptr[0..v.len]

// The index of the first x in xs, or xs.len when there is none.
func find(comptime T: type, xs: []T, x: T) -> u32 {
  for i, e in xs {
    return i when e == x
  }
  return xs.len
}

func contains(comptime T: type, xs: []T, x: T) -> bool => find(xs, x) < xs.len
func double(n: u32) -> u32 => n * 2

// The first occurrence of each element of xs, in order.
func unique(comptime T: type, xs: []T) -> *mut Vec(T) {
  let out = vec(T, xs.len)
  for x in xs {
    if !out.items().contains(x) {
      out.push(x)
    }
  }
  return out
}

data repeats = [4:u32, 7, 4, 4, 9, 7, 1]
data letters = "mississippi"

// The sum of 0 to n - 1, pushed onto a vector and read back. The space the
// vector takes is given back on the way out; a call that traps for want of
// space runs no defer, and leaves it taken.
export func sum_to(n: u32) -> (s: u32) {
  let mark = top
  defer reset(mark)
  let v = vec(u32, 4)
  for i in n {
    v.push(i)
  }
  for x in v.items() {
    s += x
  }
}

test "the receiver decides T" {
  let v = vec(u32, 2)
  for i in 100 {
    v.push(i * 3)
  }
  assert v.len == 100
  assert v.cap == 128
  assert v.get(99) == 297
  assert v.pop() == 297
  assert v.items().len == 99
  let before = top
  assert sum_to(5) == 10
  assert top == before
}

test "explicit type arguments come after the receiver" {
  let b = vec(u8, 2)
  b.push(u8, 9)
  assert b.get(u8, 0) == 9
  assert get(u8, b, 0) == 9
}

test "calls chain, and plain functions are methods too" {
  let u = unique(repeats)
  assert u.len == 4
  assert u.get(2) == 9
  assert u.items().find(1) == 3
  assert u.get(0).double() == 8
  assert unique(letters).items().len == 4
  assert unique(letters).items().contains('p')
}
