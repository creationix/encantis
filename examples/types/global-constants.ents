// A global starts as a compile-time constant. The compiler works the value
// out, so the initializer can be an expression of literals and defs, and a
// constant of one type can start a global of a wider one. A cast of a
// constant is one too: the value the cast gives at run time.

def page = 64 * 1024

data table = [3:u8, 5, 8]

global limit: u32 = 4 * page
global ratio: f64 = 3 / 2.0
global third: f32 = 1.0 / 3
global count: i64 = table.len
global whole: f64 = 7
global low: i8 = -(100 + 28)
global mask: u8 = ~0 << 4
global ones: u64 = ~0
global first: [*]u8 = table

global bits: u32 = -1 as u32
global byte: u8 = 300 as u8
global small: i8 = i8(200)
global truncated: i32 = 2.9 as i32
global wide: i64 = page as i64
global single: f64 = (0.1 as f32) as f64
global start: u32 = table as u32
global second: [*]u16 = table as [*]u16

func limit_now() -> u32 => limit
func ratio_now() -> f64 => ratio
func third_now() -> f32 => third
func count_now() -> i64 => count
func whole_now() -> f64 => whole
func low_now() -> i8 => low
func mask_now() -> u8 => mask
func ones_now() -> u64 => ones
func first_byte() -> u8 => first[0]

func bits_now() -> u32 => bits
func byte_now() -> u8 => byte
func small_now() -> i8 => small
func truncated_now() -> i32 => truncated
func wide_now() -> i64 => wide
func single_now() -> f64 => single
func start_now() -> u32 => start
func second_now() -> u16 => second[0]

// The same casts, done at run time.
func cut(n: i32) -> u8 => n as u8
func signed(n: i32) -> i8 => n as i8
func truncate(x: f64) -> i32 => x as i32
func rounded(x: f64) -> f64 => (x as f32) as f64

test "a constant expression starts a global with its value" {
  assert limit_now() == 262144
  assert ratio_now() == 1.5
  assert third_now() == 1.0:f32 / 3.0:f32
  assert low_now() == -128
}

test "a constant widens to the global's type" {
  assert count_now() == 3
  assert whole_now() == 7.0
}

test "a complement is the global's bits" {
  assert mask_now() == 0xf0
  assert ones_now() == 18446744073709551615
}

test "the address of data starts a pointer" {
  assert first_byte() == 3
}

test "a cast of a constant is the value the cast gives at run time" {
  assert bits_now() == 4294967295
  assert byte_now() == 44
  assert byte_now() == cut(300)
  assert small_now() == -56
  assert small_now() == signed(200)
  assert truncated_now() == 2
  assert truncated_now() == truncate(2.9)
  assert wide_now() == 65536
  assert single_now() == rounded(0.1)
}

test "an address cast to an integer or another pointer is the same address" {
  assert start_now() == first as u32
  assert second_now() == 0x0503
}
