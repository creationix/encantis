// continue in a count loop moves on to the next number.

// The sum of the numbers below n, skipping the multiples of three.
export func skip_threes(n: u32) -> u32 {
  let s: u32 = 0
  for i in n {
    continue when i % 3 == 0
    s += i
  }
  return s
}

// The ordered pairs of two different numbers below n. In nested loops,
// continue applies to the innermost one.
export func pairs(n: u32) -> u32 {
  let count: u32 = 0
  for i in n {
    for j in n {
      continue when i == j
      count += 1
    }
  }
  return count
}

test "continue in a count loop reaches the increment" {
  assert skip_threes(10) == 27
  assert skip_threes(0) == 0
}

test "continue in a nested count loop continues the inner loop" {
  assert pairs(4) == 12
  assert pairs(1) == 0
}
