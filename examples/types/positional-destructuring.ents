// Multiple values bind by position, with or without parentheses:
//   let (a, b) = f()    let a, b = f()    set a, b = f()

export func pair(n: u32) -> (count: u32, clipped: bool) {
  count = n + 1
  clipped = n > 5
}

// Unnamed results: positional is the only way to bind them.
export func divmod(a: u32, b: u32) -> (u32, u32) {
  return (a / b, a % b)
}

export func paren(n: u32) -> u32 {
  let (a, b) = pair(n)
  return a + (if b { 100 } else { 0 })
}

export func bare(n: u32) -> u32 {
  let a, b = pair(n)
  return a + (if b { 100 } else { 0 })
}

export func unnamed(a: u32, b: u32) -> u32 {
  let q, r = divmod(a, b)
  return q * 10 + r
}

export func reassigned(n: u32) -> u32 {
  let a, b = pair(n)
  set a, b = pair(n + 10)
  return a + (if b { 100 } else { 0 })
}

test "let (a, b) binds by position" {
  assert paren(3) == 4
  assert paren(9) == 110
}

test "let a, b is the same without parentheses" {
  assert bare(3) == 4
  assert bare(9) == 110
}

test "positional binding works for unnamed results" {
  assert unnamed(17, 5) == 32
}

test "set a, b assigns existing variables" {
  assert reassigned(1) == 112
}
