// Struct values in registers: a field of a call's result, fields of fields,
// and assignments that read the value they replace.

data space = mut [0:i32; 16]

type Point = (x: i32, y: i32)
type Rect = (origin: Point, size: Point)
type Lists = (tight: []i32, chain: []i32)

global made: u32 = 0

func rect() -> Rect {
  made += 1
  return Rect(Point(1, 2), Point(3, 4))
}

// Two slices of space: its first element, and its first two.
func lists() -> Lists {
  space[1] = 42
  return Lists(space[..1], space[..2])
}

func chains() -> u32 => lists().chain.len

test "a slice field of a call's result" {
  assert chains() == 2
  assert lists().tight.len == 1
  assert (lists().chain[1] ?? 0) == 42
}

test "a field of a field of a call's result" {
  made = 0
  assert rect().size.x == 3
  assert rect().origin.y == 2
  let size = rect().size
  assert size.y == 4
  // Each use called the function once.
  assert made == 3
}

test "a field of a struct built in place" {
  made = 0
  assert Rect(rect().size, Point(5, 6)).origin.y == 4
  assert Rect(Point(5, 6), Point(7, 8)).size.x == 7
  assert made == 1
}

test "a field of a field is assigned" {
  let r = Rect(Point(1, 2), Point(3, 4))
  r.origin.x = 7
  r.origin.y += 1
  r.size = Point(8, 9)
  assert r.origin.x == 7
  assert r.origin.y == 3
  assert r.size.x == 8
  assert r.size.y == 9
}

test "a struct rebuilt from its own fields" {
  let p = Point(1, 2)
  p = Point(p.y, p.x)
  assert p.x == 2
  assert p.y == 1
  let r = Rect(Point(1, 2), Point(3, 4))
  r.origin = Point(r.origin.y, r.origin.x)
  assert r.origin.x == 2
  assert r.origin.y == 1
}

func flipped(p: Point, s: []i32) -> i32 {
  p = Point(p.y, p.x)
  s = lists().chain
  return p.x * 10 + p.y + (s.len as i32) * 100
}

test "struct and slice parameters are assigned" {
  assert flipped(Point(1, 2), lists().tight) == 221
}
