// Mutable data and &literal cells each get their own bytes: the data section
// only shares bytes between immutable literals.

data buf = mut [0:u8; 16]

func put(p: *mut u32, v: u32) {
  p.* = v
}

test "&literal cells are distinct" {
  let a = &0:u32
  let b = &0:u32
  put(a, 1)
  put(b, 2)
  assert a.* == 1
  assert b.* == 2
}

test "a zero literal does not alias mutable zeros" {
  put(&0:u32, 7)
  assert buf[0] == 0
  let c = &0:u32
  assert c.* == 0
}
