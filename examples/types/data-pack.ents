// Data is laid out from address 8 up: address 0 is the none of an optional
// pointer or slice, so the bytes 0 to 7 are never used. sizeof data is the
// address just past the last byte of data.

data greeting = "Hello World"

test "measure data pack" {
  assert greeting == 8
  assert sizeof data == 8 + greeting.len
  let mem: [*]u8 = 8
  for i in greeting.len {
    assert greeting[i] == mem[i]
  }
}
