// Arrays laid out with data, and the types their names can take: pointers to
// fixed arrays, slices, null-terminated and many-pointers, packed
// multi-dimensional arrays, slices of strings, repeat literals and mutable
// data.

export memory

// ============================================================================
// Pointers to fixed arrays: data of an array literal is a *[N]T
// ============================================================================

// Inferred type: *[4]i32 (pointer to 4-element i32 array in data section)
data plain = [10, 20, 30, 40]

// Explicit type annotation
data typed: *[4]i32 = [100, 200, 300, 400]

// Repeat literal: N copies of a value
data zeros = [0:u8; 16]
data pattern = [0xAB:u8; 8]

// Mutable data (writable memory)
data mutable-buf = mut [0:u8; 64]

// ============================================================================
// String / byte data: what the written type makes of the bytes
// ============================================================================

// A slice: the address and the length, 12
data as-slice: []u8 = "hello, world"

// Null-terminated: appends \0, .len scans for null at runtime
data as-cstr: *[!]u8 = "hello, world"

// [!]u8 without the * is the same type, laid out the same way
data as-cstr-slice: [!]u8 = "hello, world"

// Many-pointer: raw pointer, no length info
data as-many-ptr: [*]u8 = "hello, world"

// Explicit fixed-size pointer
data as-fixed: *[12]u8 = "hello, world"

// ============================================================================
// Multi-dimensional packed arrays: *[NxM]T
// ============================================================================

// 3x3 matrix: 9 contiguous i32 values
// Indexing peels one dimension: matrix[row] -> *[3]i32
data matrix: *[3x3]i32 = [
  [1, 2, 3],
  [4, 5, 6],
  [7, 8, 9],
]

// 4x4 byte grid with ranged elements
data grid: *[4x4]u8#16 = [
  x"00 01 02 03",
  x"04 05 06 07",
  x"08 09 0a 0b",
  x"0c 0d 0e 0f",
]

// ============================================================================
// Nested pointer arrays: [][]T, [][!]T
// ============================================================================

// Slice of slices: each inner string is a slice (ptr + len)
data names: [][]u8 = ["alice", "bob", "charlie"]

// Slice of null-terminated strings
data c-names: [][!]u8 = ["alice", "bob", "charlie"]

// ============================================================================
// Tests
// ============================================================================

test "sizeof data is past the end of every data block" {
  assert sizeof data >= plain as u32 + plain.len * plain.wid
  assert sizeof data >= mutable-buf as u32 + mutable-buf.len
  assert sizeof data >= as-fixed as u32 + as-fixed.len
  assert sizeof data >= matrix as u32 + matrix.len * 3 * matrix.wid
}

test "fixed arrays" {
  assert plain[0] == 10
  assert plain[3] == 40
  assert typed[1] == 200
  assert typed[3] == 400
}

test "repeat literals" {
  assert zeros[0] == 0
  assert zeros[15] == 0
  assert pattern[0] == 0xAB
  assert pattern[7] == 0xAB
}

test "mutable data" {
  mutable-buf[0] = 42
  mutable-buf[1] = 99
  assert mutable-buf[0] == 42
  assert mutable-buf[1] == 99
}

test "slices" {
  assert as-slice.len == 12
  assert (as-slice[7] ?? 0) == 'w'     // a slice's index is checked at run time
}

test "null-terminated" {
  assert (as-cstr[0] ?? 0) == 'h'
  assert as-cstr.len == 12             // scans for the null terminator
  assert as-cstr.ptr[12] == 0          // which a [*]u8 reads unchecked
  assert as-cstr-slice.len == 12
}

test "a many-pointer and a fixed-size pointer" {
  assert as-many-ptr[4] == 'o'         // no length: not checked
  assert as-fixed.len == 12
  assert as-fixed[11] == 'd'           // a constant index below 12: proven
}

test "multi-dimensional" {
  // matrix[1] gives pointer to second row: *[3]i32
  assert matrix[0][0] == 1
  assert matrix[1][2] == 6
  assert matrix[2][2] == 9
}

test "ranged grid" {
  assert grid[0][0] == 0
  assert grid[3][3] == 15
  assert grid[2][1] == 9
}

test "nested string arrays" {
  assert names.len == 3
  assert (names[1] ?? "").len == 3
  assert c-names.len == 3
  assert (c-names[2] ?? "").len == 7        // scanned for its zero byte
}
