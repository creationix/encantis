// Named results are returned as set, whatever statement ends the function.

// Ends in an if statement (no else): the results are the named locals. Each
// starts at zero, so clipped is false unless the branch sets it.
export func clamp_count(n: u32, limit: u32) -> (count: u32, clipped: bool) {
  count = n
  if n > limit {
    count = limit
    clipped = true
  }
}

// Ends in a loop; total starts at 0.
export func sum_to(n: u32) -> (total: u32) {
  for i in n {
    total += i
  }
}

export func clamped(n: u32, limit: u32) -> u32 => clamp_count(n, limit).count
export func was_clipped(n: u32, limit: u32) -> bool => clamp_count(n, limit).clipped

test "a trailing if leaves the named results as set" {
  assert clamped(3, 5) == 3
  assert !was_clipped(3, 5)
  assert clamped(9, 5) == 5
  assert was_clipped(9, 5)
}

test "a trailing loop leaves the named result as set" {
  assert sum_to(5) == 10
}

// A bare return hands the named results back as they are set so far. (With an
// unnamed result it is an error: there is nothing for it to return.)
//
// first_factor is the least factor of n from 2 up to its square root, and
// whether there is one: there is none when n is prime or below 4. The loop
// stops when factor > n / factor, since factor * factor wraps past 65535.
export func first_factor(n: u32) -> (factor: u32, found: bool) {
  factor = 2
  loop {
    return when factor > n / factor   // past the square root: found is false
    if n % factor == 0 {
      found = true
      return
    }
    factor += 1
  }
}

test "a bare return gives back the named results as set" {
  let a = first_factor(91)
  assert a.factor == 7
  assert a.found
  let b = first_factor(97)
  assert !b.found
  assert first_factor(4).found
  assert !first_factor(2).found
  assert first_factor(4294967295).factor == 3
  assert !first_factor(4294967291).found      // the largest u32 prime
}

// A trailing value supplies the results, in order: a tuple literal (each
// element widens to its result), or a call whose results are passed on.
export func split(n: u32) -> (hi: u32, lo: u32) {
  (n >> 16, n & 0xffff)
}

export func widened(n: u16) -> (count: u64, half: f64) {
  (n, n / 2)                        // a u16 division, then widened: 9 gives 4.0
}

export func swapped(n: u32) -> (lo: u32, hi: u32) {
  split(n <<< 16)
}

test "a trailing value fills the named results in order" {
  let a = split(0x12345678)
  assert a.hi == 0x1234
  assert a.lo == 0x5678
  let b = widened(9)
  assert b.count == 9
  assert b.half == 4.0
  let c = swapped(0x12345678)
  assert c.lo == 0x5678
  assert c.hi == 0x1234
}

// An expression body is the results too.
export func halves(n: u16) -> (hi: u64, lo: f64) => (n >> 8, n & 0xff)
export func wide(n: i32) -> (r: i64) => n

test "an expression body supplies named results" {
  let h = halves(0x1234)
  assert h.hi == 0x12
  assert h.lo == 52.0
  assert wide(-7) == -7
}

// As a call's results passed on: they fill the named results in order,
// whatever the call names them, under an if or a match too.
func digits(n: u32) -> (u32, u32) => (n / 10, n % 10)

export func tens(n: u32) -> (q: u32, r: u32) => digits(n)
export func turned(n: u32) -> (lo: u32, hi: u32) => split(n <<< 16)
export func tens_or(n: u32, small: bool) -> (q: u32, r: u32) => if small { (0, n) } else { digits(n) }

test "an expression body passes a call's results on in order" {
  let t = tens(47)
  assert t.q == 4
  assert t.r == 7
  let c = turned(0x12345678)
  assert c.lo == 0x5678
  assert c.hi == 0x1234
  let s = tens_or(7, true)
  assert s.q == 0
  assert s.r == 7
  let b = tens_or(93, false)
  assert b.q == 9
  assert b.r == 3
}

// Parentheses around a value change nothing, a call's several results included.
export func grouped(n: u32) -> (q: u32, r: u32) => (digits(n))

func first(n: u32) -> u32 {
  let t: (u32, u32) = (digits(n))
  return t.0
}

test "a tuple value in parentheses is the value" {
  let g = grouped(58)
  assert g.q == 5
  assert g.r == 8
  assert first(58) == 5
}
