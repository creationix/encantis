// Optional pointers and slices, ?*T and ?[]T: none is written 0, and held as
// the address 0. An optional is read only once if let or ?? has resolved it,
// and an index checked at run time is resolved the same way.

export memory

data names: [][]u8 = ["Alice", "Bob", "Charlie"]
data scores = [95, 87, 42]:*[_]i32

// An optional pointer, resolved with if let.
export func deref_or_zero(p: ?*u32) -> u32 {
  if let val = p {
    return val.*
  }
  return 0
}

// An optional slice, resolved with ??.
export func slice_len(s: ?[]u8) -> u32 => (s ?? "empty").len

// An element of a [][]u8 at a run-time index is a ?[]u8: none past the end.
export func get_name(i: u32) -> []u8 => names[i] ?? "Unknown"

export func name_len(i: u32) -> u32 {
  if let name = names[i] {
    return name.len
  }
  return 0
}

// A number has no none, so an element of a *[N]i32 at a run-time index is
// resolved where it is read, with ?? or if let.
export func get_score(i: u32) -> i32 => scores[i] ?? -1

export func has_score(i: u32) -> bool {
  if let score = scores[i] {
    return score > 0
  }
  return false
}

// A ?[]u8 can be kept in a variable and resolved later.
export func find_name(i: u32) -> u32 {
  let maybe = names[i]
  let resolved = maybe ?? "nobody"
  return resolved.len
}

test "an optional pointer or slice is resolved before it is read" {
  assert deref_or_zero(&7) == 7
  assert deref_or_zero(0) == 0
  assert slice_len("hi") == 2
  assert slice_len(0) == 5
}

test "an index checked at run time is resolved like an optional" {
  assert get_name(2).len == 7
  assert get_name(3).len == 7
  assert name_len(1) == 3 && name_len(3) == 0
  assert get_score(2) == 42 && get_score(3) == -1
  assert has_score(0) && !has_score(3)
  assert find_name(0) == 5 && find_name(9) == 6
}
