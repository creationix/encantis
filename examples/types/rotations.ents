// <<< rotates left and >>> rotates right, within the width of the value:
// the bits that leave one end come back at the other.

func rotl32(x: u32, n: u32) -> u32 => x <<< n
func rotr32(x: u32, n: u32) -> u32 => x >>> n
func rotr64(x: u64, n: u64) -> u64 => x >>> n
func rotr_signed(x: i32, n: i32) -> i32 => x >>> n

func rotl8(x: u8, n: u8) -> u8 => x <<< n
func rotr8(x: u8, n: u8) -> u8 => x >>> n
func rotl16(x: u16, n: u32) -> u16 => x <<< n
func rotr16(x: u16, n: u32) -> u16 => x >>> n
func rotl_i8(x: i8, n: u8) -> i8 => x <<< n

func rotr128(x: u128, n: u128) -> u128 => x >>> n

func in_place(x: u32) -> u32 {
  x <<<= 8
  x >>>= 4
  return x
}

test "32- and 64-bit rotations" {
  assert rotl32(0x80000001, 1) == 0x00000003
  assert rotr32(0x80000001, 1) == 0xc0000000
  assert rotr32(0x12345678, 8) == 0x78123456
  assert rotr64(1, 1) == 0x8000000000000000
  assert rotr_signed(1, 1) == -2147483648
  assert rotr32(rotl32(0xdeadbeef, 13), 13) == 0xdeadbeef
}

test "a rotation in place" {
  assert in_place(0x12345678) == 0x23456781     // 0x34567812, then 0x23456781
}

test "8- and 16-bit values rotate within their own width" {
  assert rotl8(0x81, 1) == 0x03
  assert rotr8(0x81, 1) == 0xc0
  assert rotl8(0x12, 4) == 0x21
  assert rotl8(0x12, 12) == 0x21          // the count wraps at the width
  assert rotl16(0x8001, 4) == 0x0018
  assert rotr16(0x8001, 4) == 0x1800
  assert rotl_i8(-127, 1) == 3            // 0x81 rotates to 0x03
  assert rotl_i8(0x40, 1) == -128         // into the sign bit
}

test "a wide rotation crosses its 64-bit parts" {
  assert rotr128(1, 1) == 0x80000000000000000000000000000000
  assert rotr128(0x100000000000000000, 8) == 0x1000000000000000
}
