// base64url encoding and decoding (RFC 4648 §5), without padding

// What encode and decode return when the output is too short, and decode
// when its input is no base64url
def failed = 0xFFFFFFFF

// The alphabet: the character of each 6-bit value, A-Z a-z 0-9 - _
data encode_table = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"

// The length of the encoding of n bytes: 4 characters for each 3 bytes, and
// 2 or 3 for the 1 or 2 bytes left
func encoded_len(n: u32) -> u32 => n / 3 * 4 + match n % 3 { 1 => 2, 2 => 3, _ => 0 }

// Encodes input into output and returns the number of characters written,
// or `failed`, writing nothing, when output is too short for them
export func encode(input: []u8, output: []mut u8) -> (written: u32) {
  written = encoded_len(input.len)
  return failed when written > output.len

  // The counts keep the reads within input, and output holds all that is
  // written, so both go through the slices' pointers, unchecked
  let src = input.ptr
  let dst = output.ptr

  // Each 3 bytes are 4 characters, 6 bits each
  for g in input.len / 3 {
    let triple = (src[0]:u32 << 16) | (src[1]:u32 << 8) | src[2]
    dst[0] = encode_table[(triple >> 18) & 63]
    dst[1] = encode_table[(triple >> 12) & 63]
    dst[2] = encode_table[(triple >> 6) & 63]
    dst[3] = encode_table[triple & 63]
    src += 3
    dst += 4
  }

  // 1 byte left is 2 characters, 2 bytes are 3, the last padded with zero bits
  let left = input.len % 3
  if left == 1 {
    let byte = src[0]
    dst[0] = encode_table[byte >> 2]
    dst[1] = encode_table[(byte << 4) & 63]
  } elif left == 2 {
    let pair = (src[0]:u32 << 8) | src[1]
    dst[0] = encode_table[(pair >> 10) & 63]
    dst[1] = encode_table[(pair >> 4) & 63]
    dst[2] = encode_table[(pair << 2) & 63]
  }
}

// The 6-bit value of each byte, `invalid` for a byte outside the alphabet:
// filled in from encode_table by the first decode. It has an entry for every
// byte, so a byte indexes it with no check.
def invalid = 0xFF
data decode_table = mut [0:u8; 256]
global decode_ready = false

func init_decode() {
  return when decode_ready
  decode_table[..] = invalid
  for value, c in encode_table {
    decode_table[c] = value as u8
  }
  decode_ready = true
}

// The length of what n characters decode to: 3 bytes for each 4, and 1 or 2
// for the 2 or 3 left
func decoded_len(n: u32) -> u32 => n / 4 * 3 + match n % 4 { 2 => 1, 3 => 2, _ => 0 }

// The n characters at src as one number, 6 bits each, the first highest, or
// `failed` when one of them is outside the alphabet
func sextets(src: [*]u8, n: u32) -> u32 {
  let bits: u32 = 0
  let seen: u8 = 0
  for k in n {
    let v = decode_table[src[k]]
    seen |= v
    bits = (bits << 6) | v
  }
  return failed when seen & 0x80 != 0   // invalid has the top bit set, and no value does
  return bits
}

// Decodes input into output and returns the number of bytes written, or
// `failed` when input is no base64url or output is too short. When input
// goes wrong after its first 4 characters, the bytes of the groups before
// are already written.
export func decode(input: []u8, output: []mut u8) -> (written: u32) {
  written = decoded_len(input.len)
  return failed when written > output.len
  init_decode()

  // The counts keep the reads within input, and output holds all that is
  // written, so both go through the slices' pointers, unchecked
  let src = input.ptr
  let dst = output.ptr

  // Each 4 characters are 3 bytes
  for g in input.len / 4 {
    let quad = sextets(src, 4)
    return failed when quad == failed
    dst[0] = (quad >> 16) as u8
    dst[1] = (quad >> 8) as u8
    dst[2] = quad as u8
    src += 4
    dst += 3
  }

  // 2 characters left are 1 byte and 3 are 2, their last 4 or 2 bits
  // padding; 1 character left is no encoding
  let left = input.len % 4
  return failed when left == 1
  let tail = sextets(src, left)
  return failed when tail == failed
  if left == 2 {
    dst[0] = (tail >> 4) as u8
  } elif left == 3 {
    dst[0] = (tail >> 10) as u8
    dst[1] = (tail >> 2) as u8
  }
}

test "base64url" {
  data enc_buf = mut [0:u8; 4096]
  data dec_buf = mut [0:u8; 4096]

  // Whether out starts with the bytes of want
  func starts(out: []u8, want: []u8) -> bool {
    for i, b in want {
      return false when (out[i] ?? 0) != b
    }
    return true
  }

  // Whether input encodes to code, and code decodes back to input
  func round-trip(input: []u8, code: []u8) -> bool {
    return false when encode(input, enc_buf) != code.len || !starts(enc_buf, code)
    return false when decode(code, dec_buf) != input.len || !starts(dec_buf, input)
    return true
  }

  test "the RFC 4648 vectors" {
    assert round-trip("", "")
    assert round-trip("f", "Zg")
    assert round-trip("fo", "Zm8")
    assert round-trip("foo", "Zm9v")
    assert round-trip("foob", "Zm9vYg")
    assert round-trip("fooba", "Zm9vYmE")
    assert round-trip("foobar", "Zm9vYmFy")
  }

  test "the last two values are - and _" {
    assert round-trip(x"fbff", "-_8")
    assert round-trip(x"fbefbe", "----")
    assert round-trip(x"ffffff", "____")
  }

  test "reject invalid" {
    assert decode("!!!", dec_buf) == failed
    assert decode("Zm9v+g", dec_buf) == failed       // + and / are base64, not base64url
    assert decode("Zm9vYg==", dec_buf) == failed     // no padding
    assert decode("Zm9vY", dec_buf) == failed        // 1 character left over
    assert decode("\xC1\xC1", dec_buf) == failed     // bytes past ASCII
  }

  test "too short an output" {
    assert encode("foo", enc_buf[..3]) == failed
    assert encode("foo", enc_buf[..4]) == 4
    assert decode("Zm9vYg", dec_buf[..3]) == failed
    assert decode("Zm9vYg", dec_buf[..4]) == 4
  }
}
