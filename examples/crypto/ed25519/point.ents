// Ed25519 point operations on the twisted Edwards curve
// -x^2 + y^2 = 1 + d*x^2*y^2  where d = -121665/121666
//
// Extended coordinates (X, Y, Z, T) where x=X/Z, y=Y/Z, x*y=T/Z
// Points stored in memory: 4 field elements × 40 bytes = 160 bytes per point
// Fe layout: 5 × u64 (40 bytes), little-endian limb order

import "./field" (
  "fe-add" func fe-add(f: Fe, g: Fe) -> Fe
  "fe-sub" func fe-sub(f: Fe, g: Fe) -> Fe
  "fe-mul" func fe-mul(f: Fe, g: Fe) -> Fe
  "fe-sq" func fe-sq(f: Fe) -> Fe
  "fe-carry" func fe-carry(h: Fe) -> Fe
  "fe-reduce" func fe-reduce(f: Fe) -> Fe
  "fe-inv" func fe-inv(z: Fe) -> Fe
  "fe-eq" func fe-eq(f: Fe, g: Fe) -> bool
  "fe-d" func fe-d() -> Fe
  "fe-2d" func fe-2d() -> Fe
)

type Fe = (u64, u64, u64, u64, u64)

func fe-zero() -> Fe => (0:u64, 0:u64, 0:u64, 0:u64, 0:u64)
func fe-one() -> Fe => (1:u64, 0:u64, 0:u64, 0:u64, 0:u64)

// === Memory layout for field elements ===
// Fe in memory: 5 × u64 = 40 bytes, little-endian limb order

// Point = 4 Fe values = 20 u64 limbs = 160 bytes
// Layout: X=[0..5], Y=[5..10], Z=[10..15], T=[15..20]
data pt-buf = mut [0:u64; 120]  // 6 point slots × 20 limbs

func pt-ptr(i: u32) -> *[120]u64 => pt-buf

func pt-x(p: *mut[120]u64, i: u32#6) -> Fe => (
  p[i * 20], p[i * 20 + 1], p[i * 20 + 2], p[i * 20 + 3], p[i * 20 + 4]
)
func pt-y(p: *mut[120]u64, i: u32#6) -> Fe => (
  p[i * 20 + 5], p[i * 20 + 6], p[i * 20 + 7], p[i * 20 + 8], p[i * 20 + 9]
)
func pt-z(p: *mut[120]u64, i: u32#6) -> Fe => (
  p[i * 20 + 10], p[i * 20 + 11], p[i * 20 + 12], p[i * 20 + 13], p[i * 20 + 14]
)
func pt-t(p: *mut[120]u64, i: u32#6) -> Fe => (
  p[i * 20 + 15], p[i * 20 + 16], p[i * 20 + 17], p[i * 20 + 18], p[i * 20 + 19]
)

func pt-set-x(p: *mut[120]u64, i: u32#6, v: Fe) {
  p[i * 20] = v.0
  p[i * 20 + 1] = v.1
  p[i * 20 + 2] = v.2
  p[i * 20 + 3] = v.3
  p[i * 20 + 4] = v.4
}
func pt-set-y(p: *mut[120]u64, i: u32#6, v: Fe) {
  p[i * 20 + 5] = v.0
  p[i * 20 + 6] = v.1
  p[i * 20 + 7] = v.2
  p[i * 20 + 8] = v.3
  p[i * 20 + 9] = v.4
}
func pt-set-z(p: *mut[120]u64, i: u32#6, v: Fe) {
  p[i * 20 + 10] = v.0
  p[i * 20 + 11] = v.1
  p[i * 20 + 12] = v.2
  p[i * 20 + 13] = v.3
  p[i * 20 + 14] = v.4
}
func pt-set-t(p: *mut[120]u64, i: u32#6, v: Fe) {
  p[i * 20 + 15] = v.0
  p[i * 20 + 16] = v.1
  p[i * 20 + 17] = v.2
  p[i * 20 + 18] = v.3
  p[i * 20 + 19] = v.4
}

// === Set identity point ===

func pt-set-identity(buf: *mut[120]u64, i: u32#6) {
  pt-set-x(buf, i, fe-zero())
  pt-set-y(buf, i, fe-one())
  pt-set-z(buf, i, fe-one())
  pt-set-t(buf, i, fe-zero())
}

// === Point doubling ===

export func point-double(buf: *mut[120]u64, out: u32#6, p: u32#6) {
  let a = fe-sq(pt-x(buf, p))
  let b = fe-sq(pt-y(buf, p))
  let c = fe-carry(fe-add(fe-sq(pt-z(buf, p)), fe-sq(pt-z(buf, p))))
  let d = fe-sub(fe-zero(), a)
  let e = fe-carry(fe-sub(
    fe-sq(fe-carry(fe-add(pt-x(buf, p), pt-y(buf, p)))),
    fe-carry(fe-add(a, b))
  ))
  let g = fe-carry(fe-add(d, b))
  let f = fe-carry(fe-sub(g, c))
  let h = fe-carry(fe-sub(d, b))
  pt-set-x(buf, out, fe-mul(e, f))
  pt-set-y(buf, out, fe-mul(g, h))
  pt-set-z(buf, out, fe-mul(f, g))
  pt-set-t(buf, out, fe-mul(e, h))
}

// === Point addition ===

export func point-add(buf: *mut[120]u64, out: u32#6, p: u32#6, q: u32#6) {
  let a = fe-mul(pt-x(buf, p), pt-x(buf, q))
  let b = fe-mul(pt-y(buf, p), pt-y(buf, q))
  let c = fe-mul(fe-mul(pt-t(buf, p), pt-t(buf, q)), fe-d())
  let d = fe-mul(pt-z(buf, p), pt-z(buf, q))

  let e = fe-carry(fe-sub(
    fe-mul(
      fe-carry(fe-add(pt-x(buf, p), pt-y(buf, p))),
      fe-carry(fe-add(pt-x(buf, q), pt-y(buf, q)))
    ),
    fe-carry(fe-add(a, b))
  ))
  let f = fe-carry(fe-sub(d, c))
  let g = fe-carry(fe-add(d, c))
  let h = fe-carry(fe-add(b, a))

  pt-set-x(buf, out, fe-mul(e, f))
  pt-set-y(buf, out, fe-mul(g, h))
  pt-set-z(buf, out, fe-mul(f, g))
  pt-set-t(buf, out, fe-mul(e, h))
}

// === Point negation ===

export func point-neg(buf: *mut[120]u64, out: u32#6, p: u32#6) {
  pt-set-x(buf, out, fe-sub(fe-zero(), pt-x(buf, p)))
  pt-set-y(buf, out, pt-y(buf, p))
  pt-set-z(buf, out, pt-z(buf, p))
  pt-set-t(buf, out, fe-sub(fe-zero(), pt-t(buf, p)))
}

// === Point equality ===

export func point-eq(buf: *mut[120]u64, p: u32#6, q: u32#6) -> bool {
  let xeq = fe-eq(
    fe-carry(fe-mul(pt-x(buf, p), pt-z(buf, q))),
    fe-carry(fe-mul(pt-x(buf, q), pt-z(buf, p)))
  )
  let yeq = fe-eq(
    fe-carry(fe-mul(pt-y(buf, p), pt-z(buf, q))),
    fe-carry(fe-mul(pt-y(buf, q), pt-z(buf, p)))
  )
  return xeq && yeq
}

// === Base point G ===
// RFC 8032 §5.1: y = 4/5 mod p, x is the positive root
// These are the 5-limb representations of the affine coordinates.

func base-x() -> Fe => (
  0x62D608F25D51A:u64, 0x412A4B4F6592A:u64,
  0x75B7171A4B31D:u64, 0x1FF60527118FE:u64,
  0x216936D3CD6E5:u64
)

func base-y() -> Fe => (
  0x6666666666658:u64, 0x4CCCCCCCCCCCC:u64,
  0x1999999999999:u64, 0x3333333333333:u64,
  0x6666666666666:u64
)

export func pt-set-base(buf: *mut[120]u64, i: u32#6) {
  pt-set-x(buf, i, base-x())
  pt-set-y(buf, i, base-y())
  pt-set-z(buf, i, fe-one())
  pt-set-t(buf, i, fe-carry(fe-mul(base-x(), base-y())))
}

// === Scalar multiplication ===
// Fixed-base double-and-add, processing bits from MSB to LSB.
// scalar is a 32-byte little-endian buffer (256 bits).
// Result goes into buf[out].

export func scalar-mult(buf: *mut[120]u64, out: u32#6, base: u32#6, scalar: *[32]u8) {
  // slot 'out' = accumulator (starts as identity)
  // slot 'base' = the point to multiply
  // slot 'out+1' or 'base+1' used as temp — we use slot 4 and 5 as temps
  let tmp: u32#6 = 4
  pt-set-identity(buf, out)

  let byte-idx: u32#32 = 31
  loop {
    let byte = scalar[byte-idx]
    let bit: u32 = 7
    loop {
      // Double
      point-double(buf, tmp, out)
      // Copy tmp back to out
      pt-set-x(buf, out, pt-x(buf, tmp))
      pt-set-y(buf, out, pt-y(buf, tmp))
      pt-set-z(buf, out, pt-z(buf, tmp))
      pt-set-t(buf, out, pt-t(buf, tmp))

      // Conditionally add base if bit is set
      let mask = (byte >> bit) & 1:u8
      if mask == 1 {
        point-add(buf, tmp, out, base)
        pt-set-x(buf, out, pt-x(buf, tmp))
        pt-set-y(buf, out, pt-y(buf, tmp))
        pt-set-z(buf, out, pt-z(buf, tmp))
        pt-set-t(buf, out, pt-t(buf, tmp))
      }

      break when bit == 0
      bit -= 1
    }
    break when byte-idx == 0
    byte-idx -= 1
  }
}

// === Field element serialization ===
// Serialize fully-reduced Fe to 32 bytes little-endian

export func fe-tobytes(out: *mut[32]u8, f: Fe) {
  let r = fe-reduce(fe-carry(f))
  // 5 limbs × 51 bits = 255 bits → 32 bytes
  // Pack limbs into bytes, little-endian
  let h0 = r.0
  let h1 = r.1
  let h2 = r.2
  let h3 = r.3
  let h4 = r.4

  // Byte 0..5: h0 (51 bits)
  out[0] = h0 as u8
  out[1] = (h0 >> 8) as u8
  out[2] = (h0 >> 16) as u8
  out[3] = (h0 >> 24) as u8
  out[4] = (h0 >> 32) as u8
  out[5] = (h0 >> 40) as u8
  // Byte 6: h0[48..51] | h1[0..5]
  out[6] = ((h0 >> 48) | (h1 << 3)) as u8
  out[7] = (h1 >> 5) as u8
  out[8] = (h1 >> 13) as u8
  out[9] = (h1 >> 21) as u8
  out[10] = (h1 >> 29) as u8
  out[11] = (h1 >> 37) as u8
  // Byte 12: h1[45..51] | h2[0..2]
  out[12] = ((h1 >> 45) | (h2 << 6)) as u8
  out[13] = (h2 >> 2) as u8
  out[14] = (h2 >> 10) as u8
  out[15] = (h2 >> 18) as u8
  out[16] = (h2 >> 26) as u8
  out[17] = (h2 >> 34) as u8
  out[18] = (h2 >> 42) as u8
  // Byte 19: h2[50..51] | h3[0..7] → h2 has 1 bit left at position 50
  out[19] = ((h2 >> 50) | (h3 << 1)) as u8
  out[20] = (h3 >> 7) as u8
  out[21] = (h3 >> 15) as u8
  out[22] = (h3 >> 23) as u8
  out[23] = (h3 >> 31) as u8
  out[24] = (h3 >> 39) as u8
  // Byte 25: h3[47..51] | h4[0..4]
  out[25] = ((h3 >> 47) | (h4 << 4)) as u8
  out[26] = (h4 >> 4) as u8
  out[27] = (h4 >> 12) as u8
  out[28] = (h4 >> 20) as u8
  out[29] = (h4 >> 28) as u8
  out[30] = (h4 >> 36) as u8
  out[31] = (h4 >> 44) as u8
}

// === Point encoding ===
// RFC 8032 §5.1.2: compress (X,Y,Z,T) → 32 bytes
// Encode y as 255 bits LE, set high bit of byte 31 to sign of x

export func point-encode(out: *mut[32]u8, buf: *mut[120]u64, i: u32#6) {
  let zinv = fe-inv(pt-z(buf, i))
  let x = fe-reduce(fe-carry(fe-mul(pt-x(buf, i), zinv)))
  let y = fe-reduce(fe-carry(fe-mul(pt-y(buf, i), zinv)))
  fe-tobytes(out, y)
  // Set high bit of last byte to x's parity (low bit of x.0)
  out[31] = out[31] | ((x.0 & 1:u64) << 7) as u8
}

// === Tests ===

test "point operations" {

  test "store and load identity" {
    data b = mut [0:u64; 120]
    pt-set-identity(b, 0)
    let x = pt-x(b, 0)
    let y = pt-y(b, 0)
    let z = pt-z(b, 0)
    let t = pt-t(b, 0)
    assert fe-eq(fe-carry(x), fe-zero())
    assert fe-eq(fe-carry(y), fe-one())
    assert fe-eq(fe-carry(z), fe-one())
    assert fe-eq(fe-carry(t), fe-zero())
  }

  test "double identity gives identity" {
    data b = mut [0:u64; 120]
    pt-set-identity(b, 0)
    point-double(b, 1, 0)
    assert point-eq(b, 1, 0)
  }

  test "identity + identity = identity" {
    data b = mut [0:u64; 120]
    pt-set-identity(b, 0)
    point-add(b, 1, 0, 0)
    assert point-eq(b, 1, 0)
  }

  test "neg identity = identity" {
    data b = mut [0:u64; 120]
    pt-set-identity(b, 0)
    point-neg(b, 1, 0)
    assert point-eq(b, 1, 0)
  }

  test "p + neg(p) = identity for identity" {
    data b = mut [0:u64; 120]
    pt-set-identity(b, 0)
    point-neg(b, 1, 0)
    point-add(b, 2, 0, 1)
    pt-set-identity(b, 0)
    assert point-eq(b, 2, 0)
  }

  test "base point is on the curve" {
    data b = mut [0:u64; 120]
    // Check -x^2 + y^2 == 1 + d*x^2*y^2
    let x2 = fe-carry(fe-sq(base-x()))
    let y2 = fe-carry(fe-sq(base-y()))
    let lhs = fe-carry(fe-sub(y2, x2))
    let x2y2 = fe-carry(fe-mul(x2, y2))
    let dx2y2 = fe-carry(fe-mul(fe-d(), x2y2))
    let rhs = fe-carry(fe-add(fe-one(), dx2y2))
    assert fe-eq(fe-carry(lhs), fe-carry(rhs))
  }

  test "G + G == 2*G (double matches add)" {
    data b = mut [0:u64; 120]
    pt-set-base(b, 0)
    pt-set-base(b, 3)
    point-double(b, 1, 0)
    point-add(b, 2, 0, 3)
    assert point-eq(b, 1, 2)
  }

  test "encode base point" {
    data b = mut [0:u64; 120]
    // 1*G should encode to 5866666666...66
    data enc = mut [0:u8; 32]
    pt-set-base(b, 0)
    point-encode(enc, b, 0)
    assert enc[0] == 0x58:u8
    assert enc[1] == 0x66:u8
    assert enc[31] == 0x66:u8
  }

  test "scalar mult by 1 gives G" {
    data b = mut [0:u64; 120]
    data scalar1 = mut [0:u8; 32]
    scalar1[0] = 1:u8
    pt-set-base(b, 0)
    scalar-mult(b, 1, 0, scalar1)
    assert point-eq(b, 1, 0)
  }

  test "double G encodes correctly" {
    data b = mut [0:u64; 120]
    pt-set-base(b, 0)
    point-double(b, 2, 0)
    data enc2 = mut [0:u8; 32]
    point-encode(enc2, b, 2)
    // 2*G = c9a3f86a...6022
    assert enc2[0] == 0xc9:u8
    assert enc2[31] == 0x22:u8
  }

  test "add G+G eq double G" {
    data b = mut [0:u64; 120]
    pt-set-base(b, 0)
    pt-set-base(b, 3)
    point-add(b, 1, 0, 3)
    point-double(b, 2, 0)
    assert point-eq(b, 1, 2)
    // Now encode both — should be identical
    data ea = mut [0:u8; 32]
    data eb = mut [0:u8; 32]
    point-encode(ea, b, 1)
    point-encode(eb, b, 2)
    assert ea[0] == eb[0]
    assert ea[31] == eb[31]
  }

  test "scalar mult by 2 gives 2G" {
    data b2a = mut [0:u64; 120]
    data s2a = mut [0:u8; 32]
    s2a[0] = 2:u8
    pt-set-base(b2a, 0)
    scalar-mult(b2a, 1, 0, s2a)
    point-double(b2a, 2, 0)
    data e2a = mut [0:u8; 32]
    data e2b = mut [0:u8; 32]
    point-encode(e2a, b2a, 1)
    point-encode(e2b, b2a, 2)
    assert e2a[0] == e2b[0]
    assert e2a[1] == e2b[1]
    assert e2a[31] == e2b[31]
  }

  test "encode 2G" {
    data b2c = mut [0:u64; 120]
    data s2c = mut [0:u8; 32]
    s2c[0] = 2:u8
    pt-set-base(b2c, 0)
    scalar-mult(b2c, 1, 0, s2c)
    data e2c = mut [0:u8; 32]
    point-encode(e2c, b2c, 1)
    assert e2c[0] == 0xc9:u8
    assert e2c[1] == 0xa3:u8
    assert e2c[31] == 0x22:u8
  }

  test "scalar mult by 3" {
    data b3 = mut [0:u64; 120]
    data s3 = mut [0:u8; 32]
    s3[0] = 3:u8
    pt-set-base(b3, 0)
    scalar-mult(b3, 1, 0, s3)
    data e3 = mut [0:u8; 32]
    point-encode(e3, b3, 1)
    assert e3[0] == 0xd4:u8
    assert e3[31] == 0x12:u8
  }

  test "scalar mult by 4" {
    data b4 = mut [0:u64; 120]
    data s4 = mut [0:u8; 32]
    s4[0] = 4:u8
    pt-set-base(b4, 0)
    scalar-mult(b4, 1, 0, s4)
    data e4 = mut [0:u8; 32]
    point-encode(e4, b4, 1)
    assert e4[0] == 0x2f:u8
    assert e4[31] == 0x47:u8
  }

  test "scalar mult by 8" {
    data b8 = mut [0:u64; 120]
    data s8 = mut [0:u8; 32]
    s8[0] = 8:u8
    pt-set-base(b8, 0)
    scalar-mult(b8, 1, 0, s8)
    data e8 = mut [0:u8; 32]
    point-encode(e8, b8, 1)
    assert e8[0] == 0xb4:u8
    assert e8[31] == 0x21:u8
  }

  test "scalar mult by 255" {
    data b255 = mut [0:u64; 120]
    data s255 = mut [0:u8; 32]
    s255[0] = 255:u8
    pt-set-base(b255, 0)
    scalar-mult(b255, 1, 0, s255)
    data e255 = mut [0:u8; 32]
    point-encode(e255, b255, 1)
    assert e255[0] != 0x01:u8
  }

  test "scalar mult by 256" {
    data b256 = mut [0:u64; 120]
    data s256 = mut [0:u8; 32]
    s256[1] = 1:u8
    pt-set-base(b256, 0)
    scalar-mult(b256, 1, 0, s256)
    data e256 = mut [0:u8; 32]
    point-encode(e256, b256, 1)
    assert e256[0] != 0x01:u8
  }

  test "scalar mult by large value" {
    data blg = mut [0:u64; 120]
    data slg = mut [0:u8; 32]
    slg[0] = 0x08:u8
    slg[1] = 0x07:u8
    slg[2] = 0x06:u8
    slg[3] = 0x05:u8
    slg[4] = 0x04:u8
    slg[5] = 0x03:u8
    slg[6] = 0x02:u8
    slg[7] = 0x01:u8
    pt-set-base(blg, 0)
    scalar-mult(blg, 1, 0, slg)
    data elg = mut [0:u8; 32]
    point-encode(elg, blg, 1)
    assert elg[0] != 0x01:u8
  }
}
