// Field arithmetic mod p = 2^255 - 19
// Representation: 5 limbs of 51 bits each
// fe = a0 + a1*2^51 + a2*2^102 + a3*2^153 + a4*2^204

type Fe = (u64, u64, u64, u64, u64)

def mask51 = 0x7FFFFFFFFFFFF:u64  // 2^51 - 1

// === Constants ===

func fe-zero() -> Fe => (0:u64, 0:u64, 0:u64, 0:u64, 0:u64)
func fe-one() -> Fe => (1:u64, 0:u64, 0:u64, 0:u64, 0:u64)

// === Addition ===
// Result may not be fully reduced — limbs can exceed 51 bits slightly

export func fe-add(f: Fe, g: Fe) -> Fe {
  return (
    f.0 + g.0,
    f.1 + g.1,
    f.2 + g.2,
    f.3 + g.3,
    f.4 + g.4
  )
}

// === Subtraction ===
// Add 2*p before subtracting to keep limbs positive

export func fe-sub(f: Fe, g: Fe) -> Fe {
  // 2*p in 5-limb form: each limb gets 2*(2^51-1) + carry adjustments
  // p = 2^255 - 19, so 2p has limbs:
  // a0: 2*(2^51 - 19) = 2^52 - 38
  // a1..3: 2*(2^51 - 1) = 2^52 - 2
  // a4: 2*(2^51 - 1) = 2^52 - 2
  return (
    f.0 + 0xFFFFFFFFFFFDA:u64 - g.0,
    f.1 + 0xFFFFFFFFFFFFE:u64 - g.1,
    f.2 + 0xFFFFFFFFFFFFE:u64 - g.2,
    f.3 + 0xFFFFFFFFFFFFE:u64 - g.3,
    f.4 + 0xFFFFFFFFFFFFE:u64 - g.4
  )
}

// === Carry/reduce ===
// Propagate carries and reduce mod p

export func fe-carry(h: Fe) -> Fe {
  let h0 = h.0
  let h1 = h.1
  let h2 = h.2
  let h3 = h.3
  let h4 = h.4

  let c: u64 = 0

  c = h0 >> 51
  h1 += c
  h0 &= mask51

  c = h1 >> 51
  h2 += c
  h1 &= mask51

  c = h2 >> 51
  h3 += c
  h2 &= mask51

  c = h3 >> 51
  h4 += c
  h3 &= mask51

  // Wrap: excess in h4 gets multiplied by 19 and added to h0
  // because 2^255 ≡ 19 (mod p)
  c = h4 >> 51
  h0 += c * 19
  h4 &= mask51

  // One more carry from h0 in case c*19 overflowed
  c = h0 >> 51
  h1 += c
  h0 &= mask51

  return (h0, h1, h2, h3, h4)
}

// === Multiplication ===
// Schoolbook 5x5 multiplication with reduction mod p
// Uses the identity: 2^255 ≡ 19 (mod p)
// So limb products that would contribute to bit 255+ get multiplied by 19

export func fe-mul(f: Fe, g: Fe) -> Fe {
  let f0 = f.0
  let f1 = f.1
  let f2 = f.2
  let f3 = f.3
  let f4 = f.4

  let g0 = g.0
  let g1 = g.1
  let g2 = g.2
  let g3 = g.3
  let g4 = g.4

  // Pre-multiply by 19 for reduction: when i+j >= 5, the product
  // wraps and gets multiplied by 19
  let g1-19 = g1 * 19
  let g2-19 = g2 * 19
  let g3-19 = g3 * 19
  let g4-19 = g4 * 19

  // Accumulate products into 5 result limbs
  // h0 = f0*g0 + f1*g4*19 + f2*g3*19 + f3*g2*19 + f4*g1*19
  // h1 = f0*g1 + f1*g0 + f2*g4*19 + f3*g3*19 + f4*g2*19
  // etc.

  // We need 128-bit products. Use mul (low 64) + mul_hi (high 64)
  // and accumulate with carry.

  // For simplicity, accumulate into u128 using two u64s (lo, hi)
  // Then extract the 51-bit limb and propagate carry.

  // Each accumulator is 128 bits (lo + hi).
  // We add products one at a time, tracking carry from lo to hi.

  // h0 = f0*g0 + f1*g4_19 + f2*g3_19 + f3*g2_19 + f4*g1_19
  let h0-lo: u64 = 0
  let h0-hi: u64 = 0
  let prev: u64 = 0

  h0-lo = f0 * g0
  h0-hi = mul_hi(f0, g0)

  prev = h0-lo
  h0-lo += f1 * g4-19
  if h0-lo < prev { h0-hi += 1 }
  h0-hi += mul_hi(f1, g4-19)

  prev = h0-lo
  h0-lo += f2 * g3-19
  if h0-lo < prev { h0-hi += 1 }
  h0-hi += mul_hi(f2, g3-19)

  prev = h0-lo
  h0-lo += f3 * g2-19
  if h0-lo < prev { h0-hi += 1 }
  h0-hi += mul_hi(f3, g2-19)

  prev = h0-lo
  h0-lo += f4 * g1-19
  if h0-lo < prev { h0-hi += 1 }
  h0-hi += mul_hi(f4, g1-19)

  let h0 = h0-lo & mask51
  let c0 = (h0-lo >> 51) | (h0-hi << 13)

  // h1
  let h1-lo: u64 = 0
  let h1-hi: u64 = 0

  h1-lo = f0 * g1
  h1-hi = mul_hi(f0, g1)

  prev = h1-lo
  h1-lo += f1 * g0
  if h1-lo < prev { h1-hi += 1 }
  h1-hi += mul_hi(f1, g0)

  prev = h1-lo
  h1-lo += f2 * g4-19
  if h1-lo < prev { h1-hi += 1 }
  h1-hi += mul_hi(f2, g4-19)

  prev = h1-lo
  h1-lo += f3 * g3-19
  if h1-lo < prev { h1-hi += 1 }
  h1-hi += mul_hi(f3, g3-19)

  prev = h1-lo
  h1-lo += f4 * g2-19
  if h1-lo < prev { h1-hi += 1 }
  h1-hi += mul_hi(f4, g2-19)

  prev = h1-lo
  h1-lo += c0
  if h1-lo < prev { h1-hi += 1 }

  let h1 = h1-lo & mask51
  let c1 = (h1-lo >> 51) | (h1-hi << 13)

  // h2
  let h2-lo: u64 = 0
  let h2-hi: u64 = 0

  h2-lo = f0 * g2
  h2-hi = mul_hi(f0, g2)

  prev = h2-lo
  h2-lo += f1 * g1
  if h2-lo < prev { h2-hi += 1 }
  h2-hi += mul_hi(f1, g1)

  prev = h2-lo
  h2-lo += f2 * g0
  if h2-lo < prev { h2-hi += 1 }
  h2-hi += mul_hi(f2, g0)

  prev = h2-lo
  h2-lo += f3 * g4-19
  if h2-lo < prev { h2-hi += 1 }
  h2-hi += mul_hi(f3, g4-19)

  prev = h2-lo
  h2-lo += f4 * g3-19
  if h2-lo < prev { h2-hi += 1 }
  h2-hi += mul_hi(f4, g3-19)

  prev = h2-lo
  h2-lo += c1
  if h2-lo < prev { h2-hi += 1 }

  let h2 = h2-lo & mask51
  let c2 = (h2-lo >> 51) | (h2-hi << 13)

  // h3
  let h3-lo: u64 = 0
  let h3-hi: u64 = 0

  h3-lo = f0 * g3
  h3-hi = mul_hi(f0, g3)

  prev = h3-lo
  h3-lo += f1 * g2
  if h3-lo < prev { h3-hi += 1 }
  h3-hi += mul_hi(f1, g2)

  prev = h3-lo
  h3-lo += f2 * g1
  if h3-lo < prev { h3-hi += 1 }
  h3-hi += mul_hi(f2, g1)

  prev = h3-lo
  h3-lo += f3 * g0
  if h3-lo < prev { h3-hi += 1 }
  h3-hi += mul_hi(f3, g0)

  prev = h3-lo
  h3-lo += f4 * g4-19
  if h3-lo < prev { h3-hi += 1 }
  h3-hi += mul_hi(f4, g4-19)

  prev = h3-lo
  h3-lo += c2
  if h3-lo < prev { h3-hi += 1 }

  let h3 = h3-lo & mask51
  let c3 = (h3-lo >> 51) | (h3-hi << 13)

  // h4
  let h4-lo: u64 = 0
  let h4-hi: u64 = 0

  h4-lo = f0 * g4
  h4-hi = mul_hi(f0, g4)

  prev = h4-lo
  h4-lo += f1 * g3
  if h4-lo < prev { h4-hi += 1 }
  h4-hi += mul_hi(f1, g3)

  prev = h4-lo
  h4-lo += f2 * g2
  if h4-lo < prev { h4-hi += 1 }
  h4-hi += mul_hi(f2, g2)

  prev = h4-lo
  h4-lo += f3 * g1
  if h4-lo < prev { h4-hi += 1 }
  h4-hi += mul_hi(f3, g1)

  prev = h4-lo
  h4-lo += f4 * g0
  if h4-lo < prev { h4-hi += 1 }
  h4-hi += mul_hi(f4, g0)

  prev = h4-lo
  h4-lo += c3
  if h4-lo < prev { h4-hi += 1 }

  let h4 = h4-lo & mask51
  let c4 = (h4-lo >> 51) | (h4-hi << 13)

  // Final reduction: c4 * 19 wraps around to h0
  h0 += c4 * 19
  let c = h0 >> 51
  h0 &= mask51
  h1 += c

  return (h0, h1, h2, h3, h4)
}

// === Squaring ===
// Optimized: uses symmetry (f[i]*f[j] appears twice for i≠j)

export func fe-sq(f: Fe) -> Fe => fe-mul(f, f)

// === Scalar multiply by small constant ===

export func fe-mul-small(f: Fe, s: u64) -> Fe {
  return fe-carry((
    f.0 * s,
    f.1 * s,
    f.2 * s,
    f.3 * s,
    f.4 * s
  ))
}

// === Equality (after full reduction) ===

export func fe-reduce(f: Fe) -> Fe {
  let h = fe-carry(f)
  h = fe-carry(h)

  // Conditional subtract p: if h >= p, subtract p
  // p limbs: (2^51 - 19, 2^51 - 1, 2^51 - 1, 2^51 - 1, 2^51 - 1)
  // Check if h >= p by trying to subtract and seeing if we borrow
  let t0 = h.0 - (mask51 - 18)
  let t1 = h.1 - mask51
  let t2 = h.2 - mask51
  let t3 = h.3 - mask51
  let t4 = h.4 - mask51

  // Propagate borrows
  t1 -= (t0 >> 63) & 1
  t0 &= mask51
  t2 -= (t1 >> 63) & 1
  t1 &= mask51
  t3 -= (t2 >> 63) & 1
  t2 &= mask51
  t4 -= (t3 >> 63) & 1
  t3 &= mask51

  // If t4 didn't underflow (bit 63 not set), use t; otherwise keep h
  let use-reduced = ((t4 >> 63) & 1) ^ 1  // 1 if no underflow
  t4 &= mask51

  // Conditional select: reduced or original
  let m = 0:u64 - use-reduced  // mask: all 1s if use-reduced, all 0s otherwise
  return (
    (t0 & m) | (h.0 & ~m),
    (t1 & m) | (h.1 & ~m),
    (t2 & m) | (h.2 & ~m),
    (t3 & m) | (h.3 & ~m),
    (t4 & m) | (h.4 & ~m)
  )
}

export func fe-eq(f: Fe, g: Fe) -> bool {
  let a = fe-reduce(f)
  let b = fe-reduce(g)
  if a.0 != b.0 { return false }
  if a.1 != b.1 { return false }
  if a.2 != b.2 { return false }
  if a.3 != b.3 { return false }
  if a.4 != b.4 { return false }
  return true
}

// === Repeated squaring helper ===

func fe-sq-n(f: Fe, n: u32) -> Fe {
  let r = f
  for i in n {
    r = fe-sq(r)
  }
  return r
}

// === Inversion via Fermat's little theorem ===
// a^(-1) = a^(p-2) mod p
// p-2 = 2^255 - 21
// Uses an addition chain optimized for this exponent

export func fe-inv(z: Fe) -> Fe {
  let z2 = fe-sq(z)            // z^2
  let z9 = fe-sq(fe-sq(z2))    // z^8
  z9 = fe-mul(z9, z)           // z^9
  let z11 = fe-mul(z9, z2)     // z^11
  let z-5-0 = fe-sq(z11)       // z^22
  z-5-0 = fe-mul(z-5-0, z9)    // z^(2^5 - 1) = z^31

  let z-10-0 = fe-sq-n(z-5-0, 5)
  z-10-0 = fe-mul(z-10-0, z-5-0)    // z^(2^10 - 1)

  let z-20-0 = fe-sq-n(z-10-0, 10)
  z-20-0 = fe-mul(z-20-0, z-10-0)   // z^(2^20 - 1)

  let z-40-0 = fe-sq-n(z-20-0, 20)
  z-40-0 = fe-mul(z-40-0, z-20-0)   // z^(2^40 - 1)

  let z-50-0 = fe-sq-n(z-40-0, 10)
  z-50-0 = fe-mul(z-50-0, z-10-0)   // z^(2^50 - 1)

  let z-100-0 = fe-sq-n(z-50-0, 50)
  z-100-0 = fe-mul(z-100-0, z-50-0) // z^(2^100 - 1)

  let z-200-0 = fe-sq-n(z-100-0, 100)
  z-200-0 = fe-mul(z-200-0, z-100-0) // z^(2^200 - 1)

  let z-250-0 = fe-sq-n(z-200-0, 50)
  z-250-0 = fe-mul(z-250-0, z-50-0)  // z^(2^250 - 1)

  let z-255-21 = fe-sq-n(z-250-0, 5)
  return fe-mul(z-255-21, z11)        // z^(2^255 - 21) = z^(p-2)
}

// === Constants ===

// d = -121665/121666 mod p (twisted Edwards curve parameter)
// Precomputed value
export func fe-d() -> Fe => (
  0x34DCA135978A3:u64,
  0x1A8283B156EBD:u64,
  0x5E7A26001C029:u64,
  0x739C663A03CBB:u64,
  0x52036CEE2B6FF:u64
)

// 2*d
export func fe-2d() -> Fe => fe-carry(fe-add(fe-d(), fe-d()))

// sqrt(-1) mod p = 2^((p-1)/4) mod p
export func fe-sqrtm1() -> Fe => (
  0x61B274A0EA0B0:u64, 0xD5A5FC8F189D:u64,
  0x7EF5E9CBD0C60:u64, 0x78595A6804C9E:u64,
  0x2B8324804FC1D:u64
)

// === Exponentiation: z^(2^252 - 2) ===
// Used for square root: sqrt(a) = a^((p+3)/8) where (p+3)/8 = 2^252 - 2
// Same addition chain as fe-inv up to z^(2^250-1), then different final steps

export func fe-pow252m2(z: Fe) -> Fe {
  let z2 = fe-sq(z)
  let z9 = fe-sq(fe-sq(z2))
  z9 = fe-mul(z9, z)
  let z11 = fe-mul(z9, z2)
  let z-5-0 = fe-sq(z11)
  z-5-0 = fe-mul(z-5-0, z9)

  let z-10-0 = fe-sq-n(z-5-0, 5)
  z-10-0 = fe-mul(z-10-0, z-5-0)

  let z-20-0 = fe-sq-n(z-10-0, 10)
  z-20-0 = fe-mul(z-20-0, z-10-0)

  let z-40-0 = fe-sq-n(z-20-0, 20)
  z-40-0 = fe-mul(z-40-0, z-20-0)

  let z-50-0 = fe-sq-n(z-40-0, 10)
  z-50-0 = fe-mul(z-50-0, z-10-0)

  let z-100-0 = fe-sq-n(z-50-0, 50)
  z-100-0 = fe-mul(z-100-0, z-50-0)

  let z-200-0 = fe-sq-n(z-100-0, 100)
  z-200-0 = fe-mul(z-200-0, z-100-0)

  let z-250-0 = fe-sq-n(z-200-0, 50)
  z-250-0 = fe-mul(z-250-0, z-50-0)

  let t = fe-mul(fe-sq(z-250-0), z)  // z^(2^251 - 1)
  return fe-sq(t)                     // z^(2^252 - 2)
}

// === Tests ===

test "field arithmetic" {

  test "add and reduce" {
    let a = fe-one()
    let b = fe-one()
    let c = fe-carry(fe-add(a, b))
    assert c.0 == 2
    assert c.1 == 0:u64
  }

  test "sub identity" {
    let a = (100:u64, 200:u64, 300:u64, 400:u64, 500:u64)
    let b = fe-carry(fe-sub(a, a))
    // a - a should give 0 (mod p), but represented as 2p
    // After carry reduction it should be 0 or p or 2p
    // Let's check a - a + carry = 0 by verifying fe-eq
    assert fe-eq(fe-sub(a, a), fe-zero())
  }

  test "mul by one" {
    let a = (42:u64, 0:u64, 0:u64, 0:u64, 0:u64)
    let one = fe-one()
    let result = fe-mul(a, one)
    assert result.0 == 42
  }

  test "mul by zero" {
    let a = (12345:u64, 67890:u64, 0:u64, 0:u64, 0:u64)
    let zero = fe-zero()
    let result = fe-mul(a, zero)
    assert fe-eq(result, zero)
  }

  test "mul commutativity" {
    let a = (7:u64, 0:u64, 0:u64, 0:u64, 0:u64)
    let b = (13:u64, 0:u64, 0:u64, 0:u64, 0:u64)
    assert fe-eq(fe-mul(a, b), fe-mul(b, a))
  }

  test "small mul" {
    let a = (7:u64, 0:u64, 0:u64, 0:u64, 0:u64)
    let result = fe-mul-small(a, 6)
    assert result.0 == 42
  }

  test "square equals mul self" {
    let a = (123:u64, 456:u64, 0:u64, 0:u64, 0:u64)
    assert fe-eq(fe-sq(a), fe-mul(a, a))
  }

  test "reduction wraps mod p" {
    // 2^255 ≡ 19 (mod p)
    // So a field element with a4 = 2^51 should reduce to a0 += 19
    let big = (0:u64, 0:u64, 0:u64, 0:u64, mask51 + 1)
    let reduced = fe-carry(big)
    assert reduced.0 == 19
    assert reduced.4 == 0:u64
  }

  test "inverse of 1 is 1" {
    let one = fe-one()
    let inv = fe-inv(one)
    assert fe-eq(inv, one)
  }

  test "x * x^-1 = 1" {
    let x = (42:u64, 0:u64, 0:u64, 0:u64, 0:u64)
    let inv = fe-inv(x)
    let product = fe-mul(x, inv)
    assert fe-eq(product, fe-one())
  }

  test "inverse of large value" {
    let x = (0x123456789ABCD:u64, 0xFEDCBA987654:u64, 0:u64, 0:u64, 0:u64)
    let inv = fe-inv(x)
    let product = fe-mul(x, inv)
    assert fe-eq(product, fe-one())
  }

  test "d constant nonzero" {
    assert fe-eq(fe-d(), fe-zero()) == false
  }

  test "sqrtm1 squared is -1" {
    let s = fe-sqrtm1()
    let s2 = fe-carry(fe-sq(s))
    let neg1 = fe-carry(fe-sub(fe-zero(), fe-one()))
    assert fe-eq(s2, neg1)
  }

  test "pow252m2 recovers sqrt of 49" {
    let seven = (7:u64, 0:u64, 0:u64, 0:u64, 0:u64)
    let a = fe-carry(fe-sq(seven))
    let beta = fe-carry(fe-pow252m2(a))
    let beta2 = fe-carry(fe-sq(beta))
    let neg-a = fe-carry(fe-sub(fe-zero(), a))
    // beta^2 == a or beta^2 == -a (both valid for p ≡ 5 mod 8)
    let root = beta
    if fe-eq(beta2, a) == false {
      assert fe-eq(beta2, neg-a)
      root = fe-carry(fe-mul(beta, fe-sqrtm1()))
    }
    // root^2 must equal a
    assert fe-eq(fe-carry(fe-sq(root)), a)
    // root must be ±7
    let neg-seven = fe-carry(fe-sub(fe-zero(), seven))
    let r = fe-reduce(fe-carry(root))
    if fe-eq(r, fe-reduce(seven)) == false {
      assert fe-eq(r, fe-reduce(neg-seven))
    }
  }
}
