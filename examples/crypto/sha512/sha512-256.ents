// SHA-512/256 (FIPS 180-4 6.7): SHA-512 from another initial hash value,
// cut to its first 32 bytes.

import "./sha512" (
  "sha512-with-iv" func sha512-with-iv(hash-iv: *[8]u64, input: []u8, output: *mut [64]u8)
)

// The initial hash value of SHA-512/256 (FIPS 180-4 5.3.6.2)
data iv256 = [
  0x22312194fc2bf72c:u64, 0x9f555fa3c84c64c2,
  0x2393b86b6f53b151, 0x963877195940eabd,
  0x96283ee2a88effe3, 0xbe5e1e2553863992,
  0x2b0199fc2c85b8aa, 0x0eb72ddc81c52ca2
]

data full-hash = mut [0:u8; 64]

// Writes the SHA-512/256 hash of input to output
export func sha512-256(input: []u8, output: *mut [32]u8) {
  sha512-with-iv(iv256, input, full-hash)
  output[..] = full-hash[..32]
}

test "sha512-256" {
  data out = mut [0:u8; 32]

  // Whether input hashes to expected
  func hashes-to(input: []u8, expected: *[32]u8) -> bool {
    sha512-256(input, out)
    for i in out.len {
      return false when out[i] != expected[i]
    }
    return true
  }

  data expected-abc = x"53048e2681941ef99b2e29b76b4c7dabe4c2d0c634fc6d46e0e2f13107e7af23"

  test "abc" {
    assert hashes-to("abc", expected-abc)
  }

  data expected-empty = x"c672b8d1ef56ed28ab87c3622c5114069bdd3ad7b8f9737498d0c01ecef0967a"

  test "empty" {
    assert hashes-to("", expected-empty)
  }

  // 112 bytes: the length no longer fits the block, so it takes a second one
  data expected-896 = x"3928e184fb8690f840da3988121d31be65cb9d3ef83ee6146feac861e19b563a"

  test "896 bit message" {
    assert hashes-to(
      "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu",
      expected-896
    )
  }
}
