// SHA-1 (FIPS 180-4): the 20-byte (160-bit) hash of a message.

def block-size = 64

data iv = [
  0x67452301:u32, 0xEFCDAB89, 0x98BADCFE, 0x10325476, 0xC3D2E1F0
]

data state = mut [0:u32; 5]
data w = mut [0:u32; 80]
data pad-block = mut [0:u8; block-size]

// The big-endian u32 at ptr + offset
func load-be32(ptr: [*]u8, offset: u32) -> u32 {
  let p = ptr + offset
  return (p[0]:u32 << 24) | (p[1]:u32 << 16) | (p[2]:u32 << 8) | p[3]
}

// Stores value big-endian at ptr + offset
func store-be32(ptr: [*]mut u8, offset: u32, value: u32) {
  let p = ptr + offset
  p[0] = (value >> 24) as u8
  p[1] = (value >> 16) as u8
  p[2] = (value >> 8) as u8
  p[3] = value as u8
}

// Mixes one block of the message into the state
func compress(block: *[block-size]u8) {
  for i in 16 {
    w[i] = load-be32(block.ptr, i * 4)
  }
  // w[t] for t from 16 to 79, from the words 16, 14, 8 and 3 before it
  for i in 64 {
    w[i + 16] = (w[i + 13] ^ w[i + 8] ^ w[i + 2] ^ w[i]) <<< 1
  }

  let a = state[0]
  let b = state[1]
  let c = state[2]
  let d = state[3]
  let e = state[4]

  for t in 80 {
    let (f, k): (u32, u32) = if t < 20 {
      ((b & c) | (~b & d), 0x5A827999)
    } elif t < 40 {
      (b ^ c ^ d, 0x6ED9EBA1)
    } elif t < 60 {
      ((b & c) | (b & d) | (c & d), 0x8F1BBCDC)
    } else {
      (b ^ c ^ d, 0xCA62C1D6)
    }
    set a, b, c, d, e = ((a <<< 5) + f + e + k + w[t], a, b <<< 30, c, d)
  }

  state[0] += a
  state[1] += b
  state[2] += c
  state[3] += d
  state[4] += e
}

export func sha1(input: []u8, output: *mut [20]u8) {
  state[..] = iv

  let ptr = input.ptr
  for i in input.len / block-size {
    compress(ptr as *[block-size]u8)
    ptr += block-size
  }

  // Padding: the bytes after the last whole block, the byte 0x80, zeros, and
  // the message's length in bits in the last 8 bytes of a block. When the
  // length does not fit after the 0x80, it takes a block of its own.
  let rest = input.len % block-size
  pad-block[..] = 0
  memcpy(pad-block, ptr, rest)
  pad-block[rest] = 0x80
  if rest >= block-size - 8 {
    compress(pad-block)
    pad-block[..] = 0
  }
  let bits = input.len:u64 * 8
  store-be32(pad-block as [*]mut u8, block-size - 8, (bits >> 32) as u32)
  store-be32(pad-block as [*]mut u8, block-size - 4, bits as u32)
  compress(pad-block)

  for i in 5 {
    store-be32(output as [*]mut u8, i * 4, state[i])
  }
}

test "sha1" {
  data out = mut [0:u8; 20]

  // Whether input hashes to expected
  func hashes-to(input: []u8, expected: *[20]u8) -> bool {
    sha1(input, out)
    for i in out.len {
      return false when out[i] != expected[i]
    }
    return true
  }

  data expected-abc = x"a9993e364706816a ba3e25717850c26c 9cd0d89d"

  test "abc" {
    assert hashes-to("abc", expected-abc)
  }

  data expected-empty = x"da39a3ee5e6b4b0d 3255bfef95601890 afd80709"

  test "empty" {
    assert hashes-to("", expected-empty)
  }

  // 56 bytes: the length no longer fits the block, so it takes a second one
  data expected-448 = x"84983e441c3bd26e baae4aa1f95129e5 e54670f1"

  test "448 bit message" {
    assert hashes-to("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq", expected-448)
  }

  // 112 bytes: one whole block, then 48 bytes
  data expected-896 = x"a49b2446a02c645b f419f995b6709125 3a04a259"

  test "896 bit message" {
    assert hashes-to(
      "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu",
      expected-896
    )
  }
}
