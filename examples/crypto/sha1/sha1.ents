// SHA-1 (FIPS 180-4)
// Produces a 20-byte (160-bit) hash

data iv = [
  0x67452301:u32, 0xEFCDAB89, 0x98BADCFE, 0x10325476, 0xC3D2E1F0
]

data state = mut [0:u32; 5]
data w = mut [0:u32; 80]
data pad-block = mut [0:u8; 64]

func load-be32(ptr: *u8, offset: u32) -> u32 {
  let p = ptr + offset
  return (p[0] as u32 << 24) | (p[1] as u32 << 16) | (p[2] as u32 << 8) | p[3] as u32
}

func store-be32(ptr: *mut u8, offset: u32, value: u32) {
  let p = ptr + offset
  p[0] = (value >> 24) as u8
  p[1] = (value >> 16) as u8
  p[2] = (value >> 8) as u8
  p[3] = value as u8
}

func compress(block: *[64]u8) {
  for i in 16 {
    w[i] = load-be32(block as *u8, i * 4)
  }

  let j: u32 = 16
  while j < 80 {
    w.u32[j] = (w.u32[j - 3] ^ w.u32[j - 8] ^ w.u32[j - 14] ^ w.u32[j - 16]) <<< 1
    j += 1
  }

  let a = state[0]
  let b = state[1]
  let c = state[2]
  let d = state[3]
  let e = state[4]

  let round: u32 = 0
  while round < 80 {
    let f: u32 = 0
    let kc: u32 = 0
    if round < 20 {
      f = (b & c) | (~b & d)
      kc = 0x5A827999:u32
    } elif round < 40 {
      f = b ^ c ^ d
      kc = 0x6ED9EBA1:u32
    } elif round < 60 {
      f = (b & c) | (b & d) | (c & d)
      kc = 0x8F1BBCDC:u32
    } else {
      f = b ^ c ^ d
      kc = 0xCA62C1D6:u32
    }

    let temp = (a <<< 5) + f + e + kc + w.u32[round]
    e = d
    d = c
    c = b <<< 30
    b = a
    a = temp
    round += 1
  }

  state[0] += a
  state[1] += b
  state[2] += c
  state[3] += d
  state[4] += e
}

export func sha1(input: []u8, output: *mut [20]u8) {
  for i in 5 {
    state[i] = iv[i]
  }

  let ptr = input.ptr
  let remaining = input.len
  let total-bits: u64 = input.len as u64 * 8

  while remaining >= 64 {
    compress(ptr as *[64]u8)
    ptr += 64
    remaining -= 64
  }

  memset(pad-block, 0, 64)
  let n: u32 = 0
  while n < remaining {
    pad-block.u8[n] = ptr[n]
    n += 1
  }
  pad-block.u8[remaining] = 0x80:u8

  if remaining >= 56 {
    compress(pad-block)
    memset(pad-block, 0, 64)
  }

  store-be32(pad-block as *mut u8, 56, (total-bits >> 32) as u32)
  store-be32(pad-block as *mut u8, 60, total-bits as u32)
  compress(pad-block)

  for i in 5 {
    store-be32(output as *mut u8, i * 4, state[i])
  }
}

test "sha1" {
  data hash-out = mut [0:u8; 20]

  func check-hash(input: []u8, expected: *[20]u8) -> bool {
    sha1(input, hash-out)
    let i: u32 = 0
    while i < 20 {
      return false when hash-out.u8[i] != expected.u8[i]
      i += 1
    }
    return true
  }

  data tv-abc = "abc"
  data expected-abc = x"a9993e364706816a ba3e25717850c26c 9cd0d89d"

  test "abc" {
    assert check-hash(tv-abc, expected-abc)
  }

  data tv-empty = ""
  data expected-empty = x"da39a3ee5e6b4b0d 3255bfef95601890 afd80709"

  test "empty" {
    assert check-hash(tv-empty, expected-empty)
  }

  data tv-448 = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"
  data expected-448 = x"84983e441c3bd26e baae4aa1f95129e5 e54670f1"

  test "448 bit message" {
    assert check-hash(tv-448, expected-448)
  }
}
