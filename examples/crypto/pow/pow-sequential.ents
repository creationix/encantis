// Sequential proof-of-work using Gimli hash chains
// Each iteration depends on the previous state, so the work
// cannot be parallelized across SIMD lanes or GPU cores.
//
// Protocol:
//   1. Server picks a random 32-byte challenge and iteration count
//   2. Server runs solve(challenge, iterations), caches the result
//   3. Server sends challenge + iterations to client
//   4. Client runs solve(challenge, iterations)
//   5. Server reads the state from exported memory, at the address state()
//      returns, and compares
//
// Tradeoffs vs nonce search (pow.ents):
//   + Immune to SIMD/GPU parallelization (each step depends on the last)
//   + Deterministic timing (iterations maps directly to wall-clock time)
//   + Smaller code (no nonce loop, no zero-bit check)
//   - Server must pre-compute each challenge and cache the answer
//   - Third parties can't verify without re-doing all the work
//   - Attacker still gets ~2-5x from native code vs browser wasm
//
// The native-vs-wasm gap is inherent to any browser PoW scheme.
// Sequential chaining eliminates the much larger GPU/SIMD multiplier.

import "../gimli/gimli" "gimli" func gimli(state: *mut [12]u32)

export "mem" memory

data hash-state = mut [0:u32; 12]

// Absorbs the 32-byte challenge, two 16-byte blocks of the rate, then
// permutes the state `iterations` more times, each permutation after the
// last. The state is left in hash-state.
export func solve(challenge: *[32]u8, iterations: u32) {
  hash-state[..] = 0
  hash-state.u128[0] = challenge.u128[0]
  gimli(hash-state)
  hash-state.u128[0] ^= challenge.u128[1]
  gimli(hash-state)

  for i in iterations {
    gimli(hash-state)
  }
}

// Where solve leaves the state, 12 u32 words, for the host to read
export func state() -> *[12]u32 => hash-state

test "sequential pow" {
  data challenge = mut [0:u8; 32]
  data chained = mut [0:u32; 12]

  // A fixed challenge: byte i is i * 7 + 13
  func set-challenge() {
    for i in challenge.len {
      challenge[i] = (i * 7 + 13) as u8
    }
  }

  test "the same inputs give the same state" {
    set-challenge()
    solve(challenge, 100)
    let a = hash-state[0]
    // Same inputs must produce same result
    solve(challenge, 100)
    assert hash-state[0] == a
  }

  test "different iterations give different results" {
    set-challenge()
    solve(challenge, 100)
    let a = hash-state[0]
    solve(challenge, 101)
    assert hash-state[0] != a
  }

  test "different challenges give different results" {
    set-challenge()
    solve(challenge, 100)
    let a = hash-state[0]
    challenge[0] ^= 1
    solve(challenge, 100)
    assert hash-state[0] != a
  }

  test "each iteration is one more permutation" {
    set-challenge()
    solve(challenge, 0)
    chained[..] = hash-state
    for i in 3 {
      gimli(chained)
    }
    solve(challenge, 3)
    for i in hash-state.len {
      assert hash-state[i] == chained[i]
    }
  }

  test "the state after 100 iterations" {
    set-challenge()
    solve(challenge, 100)
    assert state() == hash-state
    assert hash-state[0] == 0x65d147fe
    assert hash-state[1] == 0xbdbe9353
    assert hash-state[2] == 0x18dfc1aa
    assert hash-state[3] == 0x739d7468
    assert hash-state[11] == 0x6e13830b
  }
}
