// SHA-256 (FIPS 180-4): the 32-byte (256-bit) hash of a message.

def block-size = 64

// The first 32 bits of the fractional parts of the square roots of the first 8 primes
data iv = [
  0x6a09e667:u32, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
  0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19
]

// The first 32 bits of the fractional parts of the cube roots of the first 64 primes
data k = [
  0x428a2f98:u32, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
  0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
  0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
  0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
  0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
  0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
  0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
  0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
  0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
]

data state = mut [0:u32; 8]
data w = mut [0:u32; 64]
data pad-block = mut [0:u8; block-size]

func ch(x: u32, y: u32, z: u32) -> u32 => (x & y) ^ (~x & z)
func maj(x: u32, y: u32, z: u32) -> u32 => (x & y) ^ (x & z) ^ (y & z)
func big-sigma0(x: u32) -> u32 => (x >>> 2) ^ (x >>> 13) ^ (x >>> 22)
func big-sigma1(x: u32) -> u32 => (x >>> 6) ^ (x >>> 11) ^ (x >>> 25)
func small-sigma0(x: u32) -> u32 => (x >>> 7) ^ (x >>> 18) ^ (x >> 3)
func small-sigma1(x: u32) -> u32 => (x >>> 17) ^ (x >>> 19) ^ (x >> 10)

// The big-endian u32 at ptr + offset
func load-be32(ptr: [*]u8, offset: u32) -> u32 {
  let p = ptr + offset
  return (p[0]:u32 << 24) | (p[1]:u32 << 16) | (p[2]:u32 << 8) | p[3]
}

// Stores value big-endian at ptr + offset
func store-be32(ptr: [*]mut u8, offset: u32, value: u32) {
  let p = ptr + offset
  p[0] = (value >> 24) as u8
  p[1] = (value >> 16) as u8
  p[2] = (value >> 8) as u8
  p[3] = value as u8
}

// Mixes one block of the message into the state
func compress(block: *[block-size]u8) {
  for i in 16 {
    w[i] = load-be32(block.ptr, i * 4)
  }
  // w[t] for t from 16 to 63, from the words 16, 15, 7 and 2 before it
  for i in 48 {
    w[i + 16] = small-sigma1(w[i + 14]) + w[i + 9] + small-sigma0(w[i + 1]) + w[i]
  }

  let a = state[0]
  let b = state[1]
  let c = state[2]
  let d = state[3]
  let e = state[4]
  let f = state[5]
  let g = state[6]
  let h = state[7]

  for t in 64 {
    let t1 = h + big-sigma1(e) + ch(e, f, g) + k[t] + w[t]
    let t2 = big-sigma0(a) + maj(a, b, c)
    set a, b, c, d, e, f, g, h = (t1 + t2, a, b, c, d + t1, e, f, g)
  }

  state[0] += a
  state[1] += b
  state[2] += c
  state[3] += d
  state[4] += e
  state[5] += f
  state[6] += g
  state[7] += h
}

export func sha256(input: []u8, output: *mut [32]u8) {
  state[..] = iv

  let ptr = input.ptr
  for i in input.len / block-size {
    compress(ptr as *[block-size]u8)
    ptr += block-size
  }

  // Padding: the bytes after the last whole block, the byte 0x80, zeros, and
  // the message's length in bits in the last 8 bytes of a block. When the
  // length does not fit after the 0x80, it takes a block of its own.
  let rest = input.len % block-size
  pad-block[..] = 0
  memcpy(pad-block, ptr, rest)
  pad-block[rest] = 0x80
  if rest >= block-size - 8 {
    compress(pad-block)
    pad-block[..] = 0
  }
  let bits = input.len:u64 * 8
  store-be32(pad-block as [*]mut u8, block-size - 8, (bits >> 32) as u32)
  store-be32(pad-block as [*]mut u8, block-size - 4, bits as u32)
  compress(pad-block)

  for i in 8 {
    store-be32(output as [*]mut u8, i * 4, state[i])
  }
}

test "sha256" {
  data out = mut [0:u8; 32]

  // Whether input hashes to expected
  func hashes-to(input: []u8, expected: *[32]u8) -> bool {
    sha256(input, out)
    for i in out.len {
      return false when out[i] != expected[i]
    }
    return true
  }

  data expected-abc = x"ba7816bf8f01cfea 414140de5dae2223 b00361a396177a9c b410ff61f20015ad"

  test "abc" {
    assert hashes-to("abc", expected-abc)
  }

  data expected-empty = x"e3b0c44298fc1c14 9afbf4c8996fb924 27ae41e4649b934c a495991b7852b855"

  test "empty" {
    assert hashes-to("", expected-empty)
  }

  // 56 bytes: the length no longer fits the block, so it takes a second one
  data expected-448 = x"248d6a61d20638b8 e5c026930c3e6039 a33ce45964ff2167 f6ecedd419db06c1"

  test "448 bit message" {
    assert hashes-to("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq", expected-448)
  }

  // 112 bytes: one whole block, then 48 bytes
  data expected-896 = x"cf5b16a778af8380 036ce59e7b049237 0b249b11e8f07a51 afac45037afee9d1"

  test "896 bit message" {
    assert hashes-to(
      "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu",
      expected-896
    )
  }
}
