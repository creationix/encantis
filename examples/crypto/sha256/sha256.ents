// SHA-256 (FIPS 180-4)
// Produces a 32-byte (256-bit) hash

data iv = [
  0x6a09e667:u32, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
  0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19
]

data k = [
  0x428a2f98:u32, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
  0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
  0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
  0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
  0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
  0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
  0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
  0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
  0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
]

data state = mut [0:u32; 8]
data w = mut [0:u32; 64]
data pad-block = mut [0:u8; 64]

inline func ch(x: u32, y: u32, z: u32) -> u32 => (x & y) ^ (~x & z)
inline func maj(x: u32, y: u32, z: u32) -> u32 => (x & y) ^ (x & z) ^ (y & z)
inline func big-sigma0(x: u32) -> u32 => (x <<< 30) ^ (x <<< 19) ^ (x <<< 10)
inline func big-sigma1(x: u32) -> u32 => (x <<< 26) ^ (x <<< 21) ^ (x <<< 7)
inline func small-sigma0(x: u32) -> u32 => (x <<< 25) ^ (x <<< 14) ^ (x >> 3)
inline func small-sigma1(x: u32) -> u32 => (x <<< 15) ^ (x <<< 13) ^ (x >> 10)

func load-be32(ptr: *u8, offset: u32) -> u32 {
  let p = ptr + offset
  return (p[0] as u32 << 24) | (p[1] as u32 << 16) | (p[2] as u32 << 8) | p[3] as u32
}

func store-be32(ptr: *mut u8, offset: u32, value: u32) {
  let p = ptr + offset
  p[0] = (value >> 24) as u8
  p[1] = (value >> 16) as u8
  p[2] = (value >> 8) as u8
  p[3] = value as u8
}

func compress(block: *[64]u8) {
  for i in 16 {
    w[i] = load-be32(block as *u8, i * 4)
  }

  let j: u32 = 16
  while j < 64 {
    w.u32[j] = small-sigma1(w.u32[j - 2]) + w.u32[j - 7] + small-sigma0(w.u32[j - 15]) + w.u32[j - 16]
    j += 1
  }

  let a = state[0]
  let b = state[1]
  let c = state[2]
  let d = state[3]
  let e = state[4]
  let f = state[5]
  let g = state[6]
  let h = state[7]

  for round in 64 {
    let t1 = h + big-sigma1(e) + ch(e, f, g) + k[round] + w[round]
    let t2 = big-sigma0(a) + maj(a, b, c)
    h = g
    g = f
    f = e
    e = d + t1
    d = c
    c = b
    b = a
    a = t1 + t2
  }

  state[0] += a
  state[1] += b
  state[2] += c
  state[3] += d
  state[4] += e
  state[5] += f
  state[6] += g
  state[7] += h
}

export func sha256(input: []u8, output: *mut [32]u8) {
  for i in 8 {
    state[i] = iv[i]
  }

  let ptr = input.ptr
  let remaining = input.len
  let total-bits: u64 = input.len as u64 * 8

  while remaining >= 64 {
    compress(ptr as *[64]u8)
    ptr += 64
    remaining -= 64
  }

  memset(pad-block, 0, 64)
  let n: u32 = 0
  while n < remaining {
    pad-block.u8[n] = ptr[n]
    n += 1
  }
  pad-block.u8[remaining] = 0x80:u8

  if remaining >= 56 {
    compress(pad-block)
    memset(pad-block, 0, 64)
  }

  store-be32(pad-block as *mut u8, 56, (total-bits >> 32) as u32)
  store-be32(pad-block as *mut u8, 60, total-bits as u32)
  compress(pad-block)

  for i in 8 {
    store-be32(output as *mut u8, i * 4, state[i])
  }
}

test "sha256" {
  data hash-out = mut [0:u8; 32]

  func check-hash(input: []u8, expected: *[32]u8) -> bool {
    sha256(input, hash-out)
    let i: u32 = 0
    while i < 32 {
      return false when hash-out.u8[i] != expected.u8[i]
      i += 1
    }
    return true
  }

  data tv-abc = "abc"
  data expected-abc = x"ba7816bf8f01cfea 414140de5dae2223 b00361a396177a9c b410ff61f20015ad"

  test "abc" {
    assert check-hash(tv-abc, expected-abc)
  }

  data tv-empty = ""
  data expected-empty = x"e3b0c44298fc1c14 9afbf4c8996fb924 27ae41e4649b934c a495991b7852b855"

  test "empty" {
    assert check-hash(tv-empty, expected-empty)
  }

  data tv-448 = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"
  data expected-448 = x"248d6a61d20638b8 e5c026930c3e6039 a33ce45964ff2167 f6ecedd419db06c1"

  test "448 bit message" {
    assert check-hash(tv-448, expected-448)
  }
}
