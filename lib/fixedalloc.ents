// The containers of a fixed capacity, FixedVec(n, T) and Ring(n, T),
// allocated on the stack of stack.ents: the header and the n elements in one
// allocation, the elements right after the header.
//
//   let scope = mark()
//   defer reset(scope)
//   let v = fixedvec(8, u32)     // *mut FixedVec(8, u32)
//   let r = ring(8, u32)         // *mut Ring(8, u32)
//
// They are here, not in fixedvec.ents and ring.ents, so that those import
// nothing: a program that holds its containers elsewhere (in data, or in
// memory of its own) has none of the stack's memory or functions.

import "./stack" (
  "mark" func mark() -> u32
  "reset" func reset(m: u32)
  "alloc" func alloc(n: u32) -> u32
)
import "./fixedvec" "FixedVec" func FixedVec(comptime n: u32, comptime T: type) -> type
import "./ring" "Ring" func Ring(comptime n: u32#2147483649, comptime T: type) -> type

// An empty FixedVec(n, T) of fixedvec.ents.
export func fixedvec(comptime n: u32, comptime T: type) -> *mut FixedVec(n, T) {
  let at = alloc(sizeof(FixedVec(n, T)) + n * sizeof(T))
  let v = at as *mut FixedVec(n, T)
  v.* = FixedVec(n, T)(0, (at + sizeof(FixedVec(n, T))) as *mut [n]T)
  return v
}

// An empty Ring(n, T) of ring.ents.
export func ring(comptime n: u32, comptime T: type) -> *mut Ring(n, T) {
  let at = alloc(sizeof(Ring(n, T)) + n * sizeof(T))
  let r = at as *mut Ring(n, T)
  r.* = Ring(n, T)(0, 0, (at + sizeof(Ring(n, T))) as *mut [n]T)
  return r
}

type Pt = (x: i32, y: i32)

test "a FixedVec: its elements lie right after the header" {
  import "./fixedvec" (
    "push" func push(comptime n: u32, comptime T: type, v: *mut FixedVec(n, T), x: T) -> bool
    "last" func last(comptime n: u32, comptime T: type, v: *FixedVec(n, T)) -> T
    "pop" func pop(comptime n: u32, comptime T: type, v: *mut FixedVec(n, T)) -> T
    "items" func items(comptime n: u32, comptime T: type, v: *FixedVec(n, T)) -> []T
  )
  let scope = mark()
  defer reset(scope)
  let v = fixedvec(3, u64)
  assert (v.buf as u32) == (v as u32) + sizeof(FixedVec(3, u64))
  assert sizeof(FixedVec(3, u64)) == 8
  assert v.push(1)
  assert v.push(2)
  assert v.last() == 2
  // Structs, and two capacities of one type
  let small = fixedvec(2, Pt)
  let big = fixedvec(16, Pt)
  for i in 5 {
    let p = Pt(i as i32, -(i as i32))
    small.push(p)
    big.push(p)
  }
  assert small.len == 2
  assert big.len == 5
  assert small.last().x == 1
  assert big.pop().y == -4
  assert big.items().ptr[3].x == 3
}

test "a Ring" {
  import "./ring" (
    "push" func ring_push(comptime n: u32, comptime T: type, r: *mut Ring(n, T), x: T)
    "oldest" func oldest(comptime n: u32, comptime T: type, r: *Ring(n, T), i: u32#n) -> T
    "newest" func newest(comptime n: u32, comptime T: type, r: *Ring(n, T)) -> T
  )
  let scope = mark()
  defer reset(scope)
  let r = ring(3, u64)
  assert (r.items as u32) == (r as u32) + sizeof(Ring(3, u64))
  for i in 7 {
    r.ring_push((i * i) as u64)
  }
  assert r.oldest(0) == 16
  assert r.newest() == 36
}
