// Standard input and output over WASI, for command-line programs run with
// `encantis run` (or any WASI runtime). Nothing allocates: input goes into a
// buffer you pass in, and output is written straight from the slices given.

import "wasi_snapshot_preview1" (
  "fd_read" func fd_read(fd: i32, iovs: [][]mut u8, nread: *mut u32) -> i32
  "fd_write" func fd_write(fd: i32, iovs: [][]u8, nwritten: *mut u32) -> i32
)

data digits = mut [0:u8; 24]

// Reads all of standard input into buf, and returns the part that was filled.
// Input longer than buf is cut off at buf.len.
export func read_all(buf: []mut u8) -> []u8 {
  let total: u32 = 0
  let nread = &0:u32
  let iov: *mut [1][]mut u8 = mut [buf]
  // total never passes buf.len, so the ?? fallbacks below never apply.
  loop {
    let free = buf[total..] ?? buf
    return buf[..total] ?? buf when free.len == 0 || total == buf.len
    iov[0] = free
    let err = fd_read(0, iov, nread)
    return buf[..total] ?? buf when err != 0 || nread.* == 0
    total += nread.*
  }
}

// Writes s to standard output.
export func print(s: []u8) {
  let left = s
  let n = &0:u32
  let iov: *mut [1][]u8 = mut [s]
  while left.len > 0 {
    iov[0] = left
    return when fd_write(1, iov, n) != 0
    left = left[n.*..] ?? ""
  }
}

// Writes s and a newline.
export func println(s: []u8) {
  print(s)
  print("\n")
}

// Writes n in decimal, then a newline.
export func print_u64(n: u64) {
  let i: u32 = 24
  let v = n
  let out = digits as [*]mut u8
  loop {
    i -= 1
    out[i] = (48 + v % 10) as u8
    v /= 10
    break when v == 0
  }
  println(digits[i..] ?? "")
}

// Writes n in decimal, with a - when negative, then a newline.
export func print_i64(n: i64) {
  if n < 0 {
    print("-")
    print_u64((0 - n) as u64)
  } else {
    print_u64(n as u64)
  }
}
